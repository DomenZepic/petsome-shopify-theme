    "faq": {
      "type": "petsome-ld-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "Kada mogu očekivati prve promjene?",
            "answer": "<p>Mnogi vlasnici prve promjene primijete za 2–3 tjedna, a za puni učinak obično je potrebno 8–12 tjedana redovite primjene. Brzina ovisi o dobi psa, stupnju tegoba i dosljednosti — zglobovi se ne obnove u jednom tjednu.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Koliko kapsula treba moj pas?",
            "answer": "<p>Doza ovisi o težini psa i navedena je na ambalaži. MobiMix se daje jednom dnevno, zajedno s obrokom.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Što ako pas ne želi progutati kapsulu?",
            "answer": "<p>Kapsulu možeš otvoriti i sadržaj posuti po hrani. Ovojnicu u tom slučaju baci.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Je li prikladan za sve pasmine i dobi?",
            "answer": "<p>Da, za sve pasmine i veličine. Važno je samo da se pridržavaš doze prema težini. Kod štenaca preporučujemo početak nakon otprilike 5. mjeseca starosti.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "Što ako kod mog psa ne bude djelovalo?",
            "answer": "<p>Imaš 90 dana. Ako ne budeš zadovoljan, piši nam i vratit ćemo ti novac – čak i ako je ambalaža već otvorena.</p>"
          }
        }
      },
