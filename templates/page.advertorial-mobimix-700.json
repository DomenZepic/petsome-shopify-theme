                "icon_color": "accent-1",
                "custom_icon_color": "#ff0000",
                "icon_text_alignment": "left",
                "text_color": "text",
                "custom_text_color": "#ff0000",
                "title": "Nehala sem gledati",
                "icon_heading_size": "h3",
                "text": "<p>Po treh tednih brez opazne razlike sem vsakič odnehala — in začela znova pri naslednjem lončku. Sedemkrat zapored.</p>",
                "text_size": 14,
                "margin_top": 15,
                "margin_bottom": 15
              },
              "blocks": {}
            }
