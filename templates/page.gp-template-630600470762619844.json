    "gp_section_630776263639827101": {
      "settings": {
        "checksum": "5071dca7e171b022cd9cbbbf866fcc6713beb1e398a9097a87b2b354c889d128_1_1_1_0__1",
        "gg0cuAgty4o_text": "4. Kdor obljublja rezultate v sedmih dneh, prodaja nekaj drugega&nbsp;",
        "ggN5jhToPSi_text": "<p>&nbsp;</p><p><span style=\"color:#121212;\">Sklepi se ne obnovijo v enem tednu. Sestavine začnejo delovati šele, ko jih je v telesu dovolj — in do tja vodi le redno, neprekinjeno dajanje.&nbsp;</span></p><p>&nbsp;</p><p><span style=\"color:#121212;\"><strong>Teden 2–3:</strong> Vstane malo lažje, energija se mu začne vračati.</span></p><p>&nbsp;</p><p><span style=\"color:#121212;\"><strong>Teden 4–6</strong>: Lastniki opažajo, da pes lažje vstane po počitku, manj šepanja in več energije.</span></p><p>&nbsp;</p><p><span style=\"color:#121212;\"><strong>Teden 7–12:</strong> Šepanje je veliko manj izrazito. Več volje za daljši sprehod. Manj tresavice. Spet deluje kot mlajši. Tukaj se izrazi končni efekt.</span></p><p>&nbsp;</p><p><span style=\"color:#121212;\"><strong>To ni protibolečinska tableta, ki deluje isti dan. Je počasna gradnja.</strong></span></p><p><span style=\"color:#121212;\"><strong>Pravo dopolnilo potrebuje 2 do 3 mesece, da doseže polno delovanje.</strong></span></p>",
        "ggfw0GQcgdu_label": "<p><strong>Preveri omejeno ponudbo</strong></p>",
        "gghMnCy3nG9_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0970/1284/2821/files/hf_20260303_084844_cc64fa69-3543-4a39-b1c5-0e6dcdcf48be.png",
        "ggj9pXf39X6_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0970/1284/2821/files/hf_20260303_084844_cc64fa69-3543-4a39-b1c5-0e6dcdcf48be.png"
      },
      "type": "gp-section-630776263639827101"
