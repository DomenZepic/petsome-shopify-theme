        "ggDF79wVkMY_text": "<p>60 - dnevna garancija</p>",
        "ggGQv_xy6cV_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0970/1284/2821/files/FCA-certification.jpg",
        "ggIOIeap3pM_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0970/1284/2821/files/microscope.svg",
