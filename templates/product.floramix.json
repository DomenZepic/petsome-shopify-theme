            "product_petsome_professional_review_BGLaVX": {
              "type": "product_petsome-professional-review",
              "name": "Petsome: Expert review",
              "settings": {
                "visibility": "desktop-hidden",
                "image": "shopify://shop_images/unnamed_1.jpg",
                "rating": 5,
                "quote": "\"Neuravnovešena prebava, praskanje in lizanje tačk pri psih pogosto niso tri ločene težave. Pogosto izvirajo iz porušenega ravnovesja v črevesju in iz imunskega odziva, ki se nanj pretirano odzove. FloraMix je zasnovan tako, da hkrati podpira vse tri člene te verige — črevesno floro, imunski odziv ter kožo in dlako. Prav zato je smiselna izbira pri psih, ki se na navadne probiotike odzovejo le delno.\"",
                "author": "Blaž Petelinek Ledinski, dr. vet. med.",
                "role": "",
                "background_color": "#ffffff",
                "star_color": "#ffcc00",
                "margin_top": 0,
                "margin_bottom": 0
              },
              "blocks": {}
            },
