          }
        },
        "bullet_4": {
          "type": "bullet",
          "settings": {
            "text": "💩 ima urejeno prebavo, trdnejše blato in manj napenjanja"
          }
        },
        "bullet_5": {
          "type": "bullet",
          "settings": {
            "text": "🌱 dobi podporo tudi na imunskem členu, ne le v črevesju"
          }
        },
        "bullet_6": {
          "type": "bullet",
          "settings": {
            "text": "🥄 dobi vse v eni merici namesto štirih različnih dodatkov"
          }
        },
        "bullet_7": {
          "type": "bullet",
          "settings": {
            "text": "📋 dobi deklarirane doze cinka, biotina in vitaminov, ne le seznam sestavin"
          }
        },
        "bullet_8": {
          "type": "bullet",
          "settings": {
            "text": "🔁 ohrani umirjeno kožo dolgoročno, ne le dokler traja en lonček"
          }
        }
