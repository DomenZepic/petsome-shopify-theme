    "petsome_timeframe_1": {
      "type": "petsome-timeframe",
      "blocks": {
        "tf_1": {
          "type": "timeframe",
          "settings": {
            "highlighted": false,
            "badge_text": "1–2 tedna",
            "title": "Prebava se umiri.",
            "text": "<p>Trdnejše blato, manj napenjanja, manj jedenja trave. To je prva sprememba, ki jo lastniki opazijo.</p>"
          }
        },
        "tf_2": {
          "type": "timeframe",
          "settings": {
            "highlighted": false,
            "badge_text": "3–4 tedni",
            "title": "Praskanja je manj.",
            "text": "<p>Praskanje pred spanjem, lizanje tačk in stresanje z glavo se umirijo. Spremembe so postopne, zato šteje vsakodnevna uporaba.</p>"
          }
        },
        "tf_3": {
          "type": "timeframe",
          "settings": {
            "highlighted": true,
            "badge_text": "6–8 tednov",
            "title": "Dlaka se spremeni.",
            "text": "<p>Gostejša na otip, bolj sijoča na svetlobi, manj dlake po kavču. To je najbolj vidna sprememba in tista, ki potrebuje največ časa.</p>"
          }
        },
        "tf_4": {
          "type": "timeframe",
          "settings": {
            "highlighted": false,
            "badge_text": "3 mesece in več",
            "title": "Umirjenost ostane.",
            "text": "<p>Cilj ni teden miru, ampak stanje, ki zdrži. Ker so podprte vse tri osi hkrati, se stvari ne vrnejo takoj, ko poide prvi lonček. To je razlika med rešitvijo in premorom.</p>"
          }
        }
      },
      "block_order": [
        "tf_1",
        "tf_2",
        "tf_3",
        "tf_4"
      ],
      "settings": {
        "heading": "<p>Kaj opaziš, ko pes začne s FloraMixom?</p>",
        "subheading": "Vrstni red je skoraj vedno enak: najprej prebava, nato praskanje, na koncu dlaka. Hitrost se od psa do psa razlikuje.",
        "columns": "4",
