            "product_petsome_professional_review_BGLaVX": {
              "type": "product_petsome-professional-review",
              "name": "Petsome: Expert review",
              "settings": {
                "visibility": "desktop-hidden",
                "image": "shopify://shop_images/unnamed_1.jpg",
                "rating": 5,
                "quote": "\"Neurejena prebava, praskanje in lizanje tačk pri psih pogosto niso tri ločene težave. Pogosto so povezani z neravnovesjem v črevesju in imunskim odzivom. FloraMix je zasnovan tako, da hkrati podpira črevesno floro, imunski odziv ter kožo in dlako. Zato je primeren tudi za pse, pri katerih navadni probiotiki ne prinesejo dovolj opazne spremembe.\"",
                "author": "Blaž Petelinek Ledinski, dr. vet. med.",
                "role": "",
                "background_color": "#ffffff",
                "star_color": "#ffcc00",
                "margin_top": 0,
