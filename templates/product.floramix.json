    "petsome_benefits_1": {
      "type": "petsome-benefits",
      "blocks": {
        "benefit_1": {
          "type": "benefit",
          "settings": {
            "image": "shopify://shop_images/FloraMix_praskanje.png",
            "icon": "pets",
            "filled_icon": false,
            "title": "Praskanje, ki se vsak večer začne znova",
            "text": "<p>Prvo, kar opaziš, ni koža — ampak prebava: trdnejše blato, manj napenjanja, manj jedenja trave. Koža pride za tem. To ni naključje, ampak vrstni red, po katerem veriga deluje.</p>"
          }
        },
        "benefit_2": {
          "type": "benefit",
          "settings": {
            "image": "shopify://shop_images/FloraMix_lizanje_tack.png",
            "icon": "directions_run",
            "filled_icon": false,
            "title": "Lizanje tačk, ki ga slišiš sredi noči",
            "text": "<p>Tisti zvok ob dveh zjutraj in rjavi madeži med prsti. Ko podpreš prebavo, imunski odziv in kožo hkrati, je lizanja manj. Najprej postanejo tišje noči, šele nato je razlika vidna tudi podnevi.</p>"
          }
        },
        "benefit_3": {
          "type": "benefit",
          "settings": {
            "image": "shopify://shop_images/FloraMix_benefits.png",
            "icon": "bolt",
            "filled_icon": true,
            "title": "Dlaka brez leska in dlake po vsem stanovanju",
            "text": "<p>Opaziš, da je dlaka gostejša na otip in bolj sijoča na svetlobi, dlake po stanovanju pa je manj. Za tem stojijo omega-3 iz krilove moke, cink v kelatni obliki in biotin, ki prispevajo k ohranjanju zdrave kože in dlake. To je sprememba, ki jo opazijo tudi drugi ljudje, ne le ti.</p>"
          }
        },
        "benefit_4": {
          "type": "benefit",
          "settings": {
            "image": "shopify://shop_images/FloraMix_graf.png",
            "icon": "shield",
            "filled_icon": true,
            "title": "Zakaj navaden probiotik ni dovolj",
            "text": "<p>Navadni probiotik podpira predvsem črevesje. FloraMix poleg črevesne flore podpira tudi imunski odziv ter kožo in dlako. Zato je formula širše zastavljena in ni namenjena samo prebavi.</p>"
          }
        }
      },
      "block_order": [
        "benefit_1",
        "benefit_2",
        "benefit_3",
        "benefit_4"
      ],
      "settings": {
        "heading": "<p>Za pse, ki se praskajo, ližejo tačke, imajo dlako brez leska ali neurejeno prebavo.</p>",
        "columns": "2",
        "accent_color": "#f8aaa7",
        "secondary_color": "#e8d6c5",
        "padding_top": 36,
