    "petsome_explainer_1": {
      "type": "petsome-explainer",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "heading": "Zakaj se praskanje vrne?",
            "text": "<p>Ker podpora samo enemu delu ni dovolj. Črevesje, imunski odziv ter koža in dlaka so povezani. Če podpreš samo črevesje, koža ostane brez podpore — in praskanje se vrne.</p>",
            "badge_text": "Urejena prebava še ne pomeni mirne kože."
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "heading": "Zakaj FloraMix deluje drugače?",
            "text": "<p>FloraMix podpira vse tri povezane dele. Cikorija, dva EU-registrirana seva in kolostrum podpirajo črevesje. Sophora japonica, beta-glukani iz kvasa in kurkuma podpirajo imunski odziv. Omega-3 iz krila, cink in biotin pa podpirajo kožo in dlako. Prašek enkrat na dan potreseš po hrani.</p>",
            "badge_text": "Tri vrste podpore v eni dnevni merici."
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2"
      ],
