        "row_5",
        "row_6",
        "row_7"
      ],
      "settings": {
        "heading": "<p>Kaj je v navadnem probiotiku in kaj v FloraMixu</p>",
        "description": "<p>Veliko se res začne v črevesju — zato so probiotični priboljški smiselni. Ampak srbenje je veriga treh členov, probiotik pa podpira samo prvega. Drugi, imunski, teče naprej sam. Zato se prebava uredi, praskanje pa ne.</p><p><strong>Razlika ni v tem, da imamo česa več. Razlika je v tem, da tega sploh nimajo.</strong></p>",
        "them_image": "shopify://shop_images/us_vs_them.png",
        "them_label": "Navadni probiotični priboljški",
        "us_image": "shopify://shop_images/hf_20260410_165922_35163d71-e03b-4543-bb9f-034c80ee9cf9.png",
        "us_label": "FloraMix",
        "background_color": "#faf9f6",
        "accent_color": "#f8aaa7",
        "accent_color_dark": "#f47671",
        "secondary_color": "#e8d6c5",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "petsome_explainer_1": {
      "type": "petsome-explainer",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "heading": "🛑 Zakaj se praskanje vedno vrne?",
            "text": "<p>Ker se srbenje ne konča v črevesju — tam se začne. Prepustna črevesna stena spusti skozi, kar ne bi smelo. Imunski sistem to prebere kot alarm in pretirano odreagira. Koža vzplamti. Probiotik pomaga prvemu členu verige, drugi pa teče naprej sam — in ko podpore zmanjka, se vse skupaj vrne.</p>",
            "badge_text": "Urejeno črevesje ≠ umirjena koža"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "heading": "✅ Zakaj FloraMix deluje drugače?",
            "text": "<p>Triple Biotic Complex naslovi vse tri člene hkrati: črevesje s cikorijo, dvema EU-registriranima sevoma in kolostrumom; imunski odziv s Sophoro japonico, beta-glukani iz kvasa in kurkumo; kožo in dlako z omega-3 iz krila, cinkom in biotinom. Ena merica na hrano, vsak dan.</p>",
            "badge_text": "Tri osi hkrati, ne le črevesje"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2"
      ],
      "settings": {
        "image": "shopify://shop_images/hf_20260324_090023_9eac1bcd-6ab4-48cb-84f0-f40b13f453d6.jpg",
        "button_label": "Naroči FloraMix",
        "button_link": "",
        "button_icon": "shopping_bag",
        "button_background_color": "#0e1111",
        "button_text_color": "#ffffff",
        "secondary_color": "#e8d6c5",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "petsome_ingredients_1": {
      "type": "petsome-ingredients",
      "settings": {
        "heading": "<p>Kaj je notri — in na kateri osi dela</p>",
        "description": "<p>Dvanajst sestavin, razporejenih po treh oseh: štiri za črevesje, štiri za imunski odziv, štiri za kožo in dlako. Vsaka s količino z deklaracije, ne le z imenom. Kliknite na sestavino za več.</p>",
        "amount_label": "Količina v paketu",
        "background_color": "#faf9f6",
        "accent_color": "#f8aaa7",
        "accent_color_dark": "#f47671",
        "secondary_color": "#e8d6c5",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "petsome_mechanism_1": {
      "type": "petsome-mechanism",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "badge_text": "ČREVESJE",
            "title": "Tam se začne — ne konča.",
            "text": "<p>Cikorijev inulin nahrani koristne bakterije, dva EU-registrirana seva (skupaj 300 milijard CFU/kg) podpirata ravnovesje črevesne flore, kolostrum pa prispeva k celovitosti črevesne stene. To je temelj — in tu se večina izdelkov ustavi.</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "badge_text": "IMUNSKI ODZIV",
            "title": "Člen, ki ga nihče ne naslovi.",
            "text": "<p>Ko stena postane bolj prepustna, se imunski sistem pretirano odzove — in prav ta odziv je tisto, kar se pokaže kot praskanje. Sophora japonica je naraven vir rutina in kvercetina, inaktivirani kvas prispeva beta-glukane, kolostrum imunske faktorje, kurkuma pa kurkuminoide. To je razlog, zakaj sam probiotik ni dovolj.</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "badge_text": "KOŽA IN DLAKA",
            "title": "Da se vidi, ne le čuti.",
            "text": "<p>Omega-3 iz krilove moke je v fosfolipidni obliki, cink v kelatni (2.600 mg/kg), biotin 895.000 µg/kg, mačeha pa je tradicionalna zeliščna podpora koži. Skupaj prispevajo k normalnemu stanju kože in dlake — k tistemu, kar lastnik dejansko vidi.</p>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3"
      ],
      "settings": {
        "kicker_text": "TRIPLE BIOTIC COMPLEX",
        "heading": "<p>Črevesje je urejeno. Zakaj se pes še vedno praska?</p>",
        "description": "<p>Ker se srbenje ne konča v črevesju — tam se začne. Teče kot veriga treh členov: prepustna črevesna stena spusti skozi, kar ne bi smelo; imunski sistem to prebere kot alarm in pretirano odreagira; koža vzplamti. Probiotik pomaga prvemu členu. Drugi teče naprej sam. <strong>Triple Biotic Complex naslovi vse tri hkrati</strong> — zato umirjenost zdrži, namesto da se vrne.</p>",
        "pattern_image": "shopify://shop_images/paw_background.png",
        "background_color": "#e8d6c5",
        "kicker_background": "#e0b58d",
        "card_background": "#ffffff",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "petsome_before_after_1": {
      "type": "petsome-before-after",
      "blocks": {
        "story_1": {
          "type": "story",
          "settings": {
            "image": "shopify://shop_images/Kaching-Bundles-igC1PeA1mofml_AY0kJypTCCc.jpg",
            "dog_name": "Rio, 4-letni francoski buldog",
            "issue": "Lizanje tačk ponoči",
            "text": "<p>Rio si je tačke lizal vsako noč, med prsti je imel rjave madeže. Lastnica poroča, da se je najprej uredila prebava, po treh tednih pa so noči postale opazno tišje.</p>"
          }
        },
        "story_2": {
          "type": "story",
          "settings": {
            "image": "shopify://shop_images/Kaching-Bundles-igC1PeA1mofml_AY0kJypTCCc.jpg",
            "dog_name": "Maša, 6-letna labradorka",
            "issue": "Praskanje in medla dlaka",
            "text": "<p>Maša se je praskala vsak večer, dlaka je bila medla in je izpadala. Po dveh mesecih rednega FloraMixa je dlaka po besedah lastnice gostejša in bolj sijoča, praskanja pa je manj.</p>"
          }
        },
        "story_3": {
          "type": "story",
          "settings": {
            "image": "shopify://shop_images/Kaching-Bundles-igC1PeA1mofml_AY0kJypTCCc.jpg",
            "dog_name": "Ari, 5-letni zlati prinašalec",
            "issue": "Stresanje z glavo, ponavljajoče se težave z ušesi",
            "text": "<p>Ari je nenehno stresal z glavo in praskal po ušesih. Lastnica je pred tem poskusila že tri različne dodatke. S FloraMixom poroča o mirnejših večerih in manj praskanja.</p>"
          }
        }
      },
      "block_order": [
        "story_1",
        "story_2",
        "story_3"
      ],
      "disabled": true,
      "settings": {
        "heading": "<p>Dokazi so v rezultatih</p>",
        "description": "<p>Pomagali smo že več kot 10.000 psom po vsej Evropi. Tukaj je nekaj njihovih zgodb.</p>",
        "border_color": "#e8d6c5",
        "padding_top": 80,
        "padding_bottom": 80
      }
    },
