    "pl_bar1": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.plx{--plx-ink:#2a2140;--plx-mut:#565858;--plx-acc:#8a6fc0;--plx-soft:#efe7f8;--plx-line:#e3ded4;\n max-width:1144px;margin:0 auto;padding:0 16px;\n font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;color:var(--plx-ink)}\n.plx *{box-sizing:border-box}\n.plx__head{max-width:648px;margin:0 auto 32px;text-align:center;display:flex;flex-direction:column;gap:8px}\n.plx__head h2{font-size:28px;line-height:1.2;font-weight:700;margin:0}\n.plx__head p{font-size:16px;line-height:1.5;color:var(--plx-mut);margin:0}\n@media(min-width:750px){.plx__head h2{font-size:34px}}\n\n/* 4 koristi z okroglo ikono */\n.plx-ben{display:grid;grid-template-columns:1fr;gap:32px}\n@media(min-width:750px){.plx-ben{grid-template-columns:repeat(4,1fr);gap:24px}}\n.plx-ben__i{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;text-align:center}\n.plx-ben__badge{display:flex;align-items:center;justify-content:center;border-radius:9999px;\n height:88px;width:88px;min-height:88px;min-width:88px;background:var(--plx-soft);font-size:34px;line-height:1}\n.plx-ben__t{font-size:20px;font-weight:600;line-height:1.25;margin:0}\n.plx-ben__b{font-size:16px;line-height:1.5;color:var(--plx-mut);margin:0}\n\n/* velike statistike: besedilo levo, slika DESNO (pri njih flex-row-reverse) */\n.plx-statrow{display:flex;flex-direction:column-reverse;gap:40px;align-items:stretch}\n@media(min-width:640px){.plx-statrow{flex-direction:row-reverse;justify-content:space-between}}\n.plx-statrow__img{width:100%;flex-shrink:0}\n@media(min-width:640px){.plx-statrow__img{width:50%}}\n@media(min-width:750px){.plx-statrow__img{width:41%}}\n.plx-statrow__img .plx-frame1{position:relative;width:100%;overflow:hidden;aspect-ratio:1/1;border-radius:16px}\n@media(min-width:750px){.plx-statrow__img .plx-frame1{border-radius:24px}}\n.plx-statrow__img img{width:100%;height:100%;object-fit:cover;object-position:center;display:block}\n.plx-statrow__body{display:flex;flex-direction:column;gap:24px;margin:auto 0;width:100%;align-items:center;text-align:center}\n@media(min-width:640px){.plx-statrow__body{width:50%;align-items:flex-start;text-align:left}}\n.plx-statrow__body h2{font-size:24px;line-height:1.2;font-weight:700;margin:0}\n@media(min-width:750px){.plx-statrow__body h2{font-size:34px}}\n.plx-statrow__body>p{font-size:16px;line-height:1.5;color:var(--plx-mut);margin:0}\n/* velike statistike */\n.plx-stat{display:grid;grid-template-columns:1fr 1fr;gap:16px;width:100%}\n@media(min-width:750px){.plx-stat{gap:24px;max-width:420px}}\n.plx-stat__i{display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-start;text-align:left;\n padding:16px 0;border-top:1px solid var(--plx-line);flex:1;min-width:166px}\n@media(min-width:750px){.plx-stat__i{padding:24px 0}}\n.plx-stat__n{font-family:Georgia,'Times New Roman',serif;font-size:32px;font-weight:600;line-height:1.2;color:var(--plx-ink)}\n@media(min-width:750px){.plx-stat__n{font-size:48px}}\n.plx-stat__l{font-size:14px;font-weight:600;line-height:1.4;margin-top:8px}\n@media(min-width:750px){.plx-stat__l{font-size:16px}}\n.plx-stat__s{font-size:13px;color:var(--plx-mut);font-weight:400;margin-top:6px}\n\n/* 4 male statistike na obarvani podlagi */\n.plx-soft-sec{background:#f4f1fa;margin:0 -100vw;padding:56px 100vw}\n.plx-mini{display:grid;grid-template-columns:1fr 1fr;gap:24px;justify-items:center;text-align:center}\n@media(min-width:750px){.plx-mini{grid-template-columns:repeat(4,1fr)}}\n.plx-mini__n{font-family:Georgia,'Times New Roman',serif;font-size:32px;font-weight:600;line-height:1.2}\n@media(min-width:750px){.plx-mini__n{font-size:48px}}\n.plx-mini__l{font-size:14px;font-weight:600;line-height:1.4;margin-top:6px}\n\n/* vet blok: slika levo, citata desno (kot pri njih) */\n.plx-vetrow{display:flex;flex-direction:column;gap:24px;align-items:stretch}\n@media(min-width:750px){.plx-vetrow{flex-direction:row;gap:40px}}\n.plx-vetrow__img{width:100%;flex-shrink:0}\n@media(min-width:640px){.plx-vetrow__img{width:50%}}\n@media(min-width:750px){.plx-vetrow__img{width:41%}}\n.plx-vetrow__img .plx-frame{position:relative;width:100%;overflow:hidden;aspect-ratio:4/5;border-radius:16px}\n@media(min-width:750px){.plx-vetrow__img .plx-frame{border-radius:24px}}\n.plx-vetrow__img img{width:100%;height:100%;object-fit:cover;object-position:center;display:block}\n.plx-vets{display:flex;flex-direction:column;gap:24px;margin:auto 0;width:100%}\n.plx-vet{background:#fff;border:1px solid var(--plx-line);border-radius:12px;padding:24px}\n.plx-vet p{font-style:italic;font-size:16px;line-height:1.5;margin:0 0 14px}\n.plx-vet__n{font-size:14px;font-weight:700;margin:0}\n.plx-vet__r{font-size:13px;color:var(--plx-mut);margin:2px 0 0}\n\n/* znacke kakovosti */\n.plx-q{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n@media(min-width:750px){.plx-q{grid-template-columns:repeat(4,1fr)}}\n.plx-q__i{display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;\n background:#fff;border:1px solid var(--plx-line);border-radius:12px;padding:20px 14px}\n.plx-q__e{font-size:28px;line-height:1}\n.plx-q__t{font-size:14px;font-weight:700;line-height:1.3}\n\n/* socialni pas s CTA */\n.plx-bar{text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px}\n.plx-bar__btn{display:inline-block;background:var(--plx-ink);color:#fff;text-decoration:none;\n font-weight:700;font-size:15px;letter-spacing:.04em;text-transform:uppercase;\n padding:16px 40px;border-radius:6px;min-width:260px}\n.plx-bar__p{font-size:14px;color:var(--plx-mut);margin:0}\n\n/* dokazi strank, centrirano in ozko */\n.plx-res{max-width:765px;margin:0 auto;text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px}\n.plx-res__stars{color:#ff9a0a;letter-spacing:3px;font-size:16px}\n.plx-res__q{font-size:18px;font-weight:600;line-height:1.4;max-width:520px;margin:0}\n.plx-res__w{font-size:13px;color:var(--plx-mut);text-transform:uppercase;letter-spacing:.06em;margin:0}\n.plx-note{background:#fff8e6;border:1px solid #efdfa4;color:#7a5c12;font-size:13px;\n border-radius:8px;padding:10px 12px;margin:18px auto 0;max-width:648px;text-align:left}\n</style><div class=\"plx\"><div class=\"plx-bar\">\n <a class=\"plx-bar__btn\" href=\"#offer\">NAROČI ZDAJ</a>\n <p class=\"plx-bar__p\"><span style=\"color:#a8712f;font-weight:700;background:#f6ead9;border-radius:4px;padding:0 4px\">VPIŠI št.</span> &mdash; Pridruži se X lastnikom psov, ki izbirajo FloraMix</p>\n</div></div>",
        "display_id": false,
        "visibility": "always-display",
        "color_scheme": "background-1",
        "padding_top": 32,
        "padding_bottom": 56
      }
