    "reasons_b": {
      "type": "petsome-ld-reasons",
      "blocks": {
        "r4": {
          "type": "reason",
          "settings": {
            "tag": "v čem je razlika",
            "title": "Sophora japonica — tisto, česar drugi nimajo",
            "text": "<p>Trojica pre-, pro- in postbiotikov ni razlika: to oglašuje danes vsak. Razlika je <strong>Sophora japonica 5 %</strong>, ki je pri nas ne najdeš v nobenem konkurenčnem dodatku za pse. Zraven kolostrum 13,3 % in krilova moka 22,44 % — ne lososovo olje, ampak krill.</p>",
            "image": "shopify://shop_images/FloraMix_SLO_06_odmerjanje.png"
          }
        },
        "r5": {
          "type": "reason",
          "settings": {
            "tag": "kako se uporablja",
            "title": "Potreseš po obroku in premešaš",
            "text": "<p>Brez skrivanja v siru, brez pregovarjanja, brez še ene tablete. FloraMix je prah — odmerek prilagodiš teži psa in ga zmešaš v obrok. Pes ne opazi, da si karkoli naredil.</p>",
            "image": "shopify://shop_images/FloraMix_sijoca_dlaka.png"
          }
        },
        "r6": {
          "type": "reason",
          "settings": {
            "tag": "kaj je notri",
            "title": "Vse količine izpisane. Izdelano v EU.",
            "text": "<p>Pri FloraMixu ni mešanice brez številk: krilova moka 22,44 % · kolostrum 13,3 % · Sophora japonica 5 % · maceha 3,33 % · kurkuma. Petnajst aktivnih sestavin in vsaka s svojo količino. Razvito v Sloveniji, izdelano v EU.</p>",
            "image": "shopify://shop_images/FloraMix_checklist.png"
          }
        }
      },
      "block_order": [
        "r4",
        "r5",
        "r6"
      ],
