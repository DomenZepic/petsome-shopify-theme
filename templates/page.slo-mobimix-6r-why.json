    "petsome_home_reviews_nntxYK": {
      "type": "petsome-home-reviews",
      "blocks": {
        "review_3HBhMy": {
          "type": "review",
          "settings": {
            "rating": 5,
            "body": "\"Maj bi moral biti operiran, žal pa so na isti dan operirali mene. Namreč ima kronično vnetje kolenskih sklepov. Po treh tednih jemanja MobiMixa je Maj čudežno shodil. Veterinarja vprašam, kaj sedaj to pomeni. Veterinar mi odgovori, da nima druge razlage kot da je to božji čudež. Ta božji čudež traja že leto dni in upam, da bo trajal in trajal.\"",
            "author": "Branko Teršek",
            "dog": "12-letni ovčar"
          }
        },
        "review_dpFKaz": {
          "type": "review",
          "settings": {
            "avatar": "shopify://shop_images/natasa-zivko-tecaj_1.png",
            "rating": 5,
            "body": "\"Pred dvema letoma in pol sem za svojo 12 let in pol staro psičko iskala dodatek, ki bi pokrival širši spekter. Po priporočilu sem zasledila MobiMix in psički se je stanje v roku enega meseca tako izboljšalo, da je bila sposobna ponovno sama iti po stopničkah. MobiMix me je tako prepričal, da sem ga uvrstila na svoje poličke, in ga od takrat redno priporočam strankam.\"",
            "author": "Nataša Živko, ZOO AJKA in kinološka sodnica",
            "dog": "12,5-letna psička"
          }
        },
        "review_TaVPGa": {
          "type": "review",
          "settings": {
            "avatar": "shopify://shop_images/image00018.jpg",
            "rating": 5,
            "body": "\"Glede na to, koliko sva z Eliko predelala, so se pojavile določene težave z gibanjem. Ko sva pred dvema letoma začela uporabljati MobiMix, so težave izvenele, kar je zopet pripomoglo k letošnjemu rezultatu na svetovnem prvenstvu. Ker je MobiMix pomagal Eliki, ga preventivno dajem tudi ostalim psom.\"",
            "author": "Tomaž Režonja, 5x svetovni prvak",
            "dog": "Elika, svetovna prvakinja v sledenju"
          }
        },
