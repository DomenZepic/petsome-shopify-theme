    "faq": {
      "type": "petsome-ld-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "Kdaj lahko pričakujem prve spremembe?",
            "answer": "<p>Mnogi lastniki prve spremembe opazijo v 2–3 tednih, za poln učinek pa je običajno potrebnih 8–12 tednov redne uporabe. Hitrost je odvisna od starosti psa, stopnje težav in doslednosti — sklepi se ne obnovijo v enem tednu.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Koliko kapsul potrebuje moj pes?",
            "answer": "<p>Odmerek je odvisen od teže psa in je naveden na embalaži. MobiMix se daje enkrat dnevno, skupaj z obrokom.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Kaj če pes kapsule noče pogoltniti?",
            "answer": "<p>Kapsulo lahko odpreš in vsebino potreseš po hrani. Ovojnico v tem primeru zavrzi.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Je primeren za vse pasme in starosti?",
            "answer": "<p>Da, za vse pasme in velikosti. Pomembno je le, da upoštevaš odmerek glede na težo. Pri mladičih priporočamo začetek po približno 5. mesecu starosti.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "Kaj če pri mojem psu ne bo delovalo?",
            "answer": "<p>Na voljo imaš 90 dni. Če ne boš zadovoljen, nam piši in denar ti vrnemo – tudi če je embalaža že odprta.</p>"
          }
        }
      },
