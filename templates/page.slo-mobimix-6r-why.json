    "timeline": {
      "type": "petsome-ld-timeline",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "badge_text": "2.-3. TEDEN",
            "text": "<p>Vstajanje je lažje. Prvi in najhitrejši znak — pes se po ležanju pobere hitreje in manj okleva, preden greš z njim ven.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "badge_text": "4.-6. TEDEN",
            "text": "<p>Sprehod je daljši. Manj postankov, manj šepanja po vrnitvi domov, več volje za igro.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "badge_text": "3. MESEC",
            "text": "<p>Stopnice niso več ovira. Tu lastniki najpogosteje omenijo, da pes spet skoči v avto ali na kavč sam — brez pomoči.</p>"
          }
        }
      },
      "block_order": [
        "step_1",
