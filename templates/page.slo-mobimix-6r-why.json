    "faq": {
      "type": "petsome-ld-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "Kdaj lahko pričakujem prve spremembe?",
            "answer": "<p>Svež zadah večina lastnikov opazi v 7 do 14 dneh. Za vidno razliko na zobeh priporočamo 2 do 3 mesece redne uporabe.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Ali odstrani zobni kamen, ki je že tam?",
            "answer": "<p>Ne. Star, strjen kamen lahko odstrani samo veterinar. DentalMix poskrbi za to, da se novi ne nabira naprej.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Kako psu dam DentalMix?",
            "answer": "<p>Odmerek, prilagojen teži psa, potreseš po hrani. Brez ščetke in brez boja — pes samo poje svoj obrok.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Je primeren za vse pasme in starosti?",
            "answer": "<p>Primeren je za odrasle pse vseh pasem, tudi za majhne in starejše, ki priboljška ne morejo prežvečiti. Če je psička breja ali doji oziroma pes jemlje zdravila, se posvetuj z veterinarjem.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "Kaj če pri mojem psu ne bo delovalo?",
            "answer": "<p>Na voljo imaš 90 dni. Če ne boš zadovoljen, nam piši in denar ti vrnemo – tudi če je embalaža že odprta.</p>"
          }
        }
      },
