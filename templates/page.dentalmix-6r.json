    "timeline": {
      "type": "petsome-ld-timeline",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "badge_text": "7.–14. DAN",
            "text": "<p>Zadah se umiri. To je prvi in najhitrejši znak — pes ti spet lahko pride blizu v obraz, ne da bi obrnil glavo stran.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "badge_text": "1. MESEC",
            "text": "<p>Nove obloge se ne nabirajo več. Kar je bilo mehko, se ne strjuje naprej, in zobje ostanejo takšni, kot so, namesto da bi se vsak mesec poslabšali.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "badge_text": "2.–3. MESEC",
            "text": "<p>Razlika je vidna na kočnikih. Tu večina lastnikov omeni, da veterinar ob naslednjem pregledu ne omeni več čiščenja pod anestezijo.</p>"
          }
        }
      },
      "block_order": [
