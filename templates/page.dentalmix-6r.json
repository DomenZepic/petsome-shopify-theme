    "reasons": {
      "type": "petsome-ld-reasons",
      "blocks": {
        "reason_1": {
          "type": "reason",
          "settings": {
            "tag": "1. razlog",
            "title": "Dentalne palčke in priboljški ne delujejo! DentalMix napade izvor slabega zadaha in rumenih zob.",
            "text": "<p>Večina dentalnih izdelkov vonj samo za nekaj ur prekrije ali očisti le površino. DentalMix deluje skozi slino in napade izvor vonja in oblog, _______. Rezultat je trajno svežji zadah, čistejši videz zob in bolj zdrave dlesni.</p>",
            "image": "shopify://shop_images/hf_20260817_203054_072c99f0-3c50-4e70-9ec5-bb4f709b9b5e.png"
          }
        },
        "reason_2": {
          "type": "reason",
          "settings": {
            "tag": "2. razlog",
            "title": "Ustvarili strokovnjaki, _______ — dentalni prašek za pse.",
            "text": "<p>Sestavo smo razvili skupaj z veterinarjem, _______. _______, druga meritev pa je pokazala, da se zmanjša glavna snov, ki povzroča zadah, _______. Izid so svežji zadah, manj oblog in belejši videz zob — brez boja s ščetko.</p>",
            "image": "shopify://shop_images/hf_20260817_203918_b355d81a-2aa3-4f9f-ad01-2e849955b5e2.png"
          }
        },
        "reason_3": {
          "type": "reason",
          "settings": {
            "tag": "3. razlog",
            "title": "Edinstvena večdelna dentalna mešanica: Veže. Razgradi. Osveži.",
            "text": "<p>DentalMix združuje več ciljanih sestavin, ki delujejo skupaj.<br>Probiotična mešanica pomaga uravnavati bakterije v gobcu in cilja na plast, na kateri nastane zobni kamen.<br>Hidrolizirane rjave alge in natrijev tripolifosfat neposredno napadejo nabiranje in bakterijsko plast, ki obarva zobe in ustvarja vonj.<br>Rastlinska izvlečka zelenega čaja in granatnega jabolka delujeta na to plast in podpirata zdrave dlesni.</p>",
            "image": "shopify://shop_images/hf_20260817_204031_999dda0c-8d44-4ea1-a65e-a2eee6fb9d24.png"
          }
        },
        "reason_4": {
          "type": "reason",
          "settings": {
            "tag": "4. razlog",
            "title": "Vidno čistejši zobje in svež zadah v 90 dneh ali manj.",
            "text": "<p>Za mnoge lastnike je to prva metoda, s katero sploh pridejo do mest, kjer se nabirata obarvanost in obloga. Večina lastnikov poroča o vidno čistejših zobeh in svetlejšem videzu znotraj tega obdobja, _______.</p>",
            "image": "shopify://shop_images/hf_20260817_204213_b2ff668a-8942-4745-aa0c-0f7e4b127bd0.png"
          }
        },
        "reason_5": {
          "type": "reason",
          "settings": {
            "tag": "5. razlog",
            "title": "Obožuje ga _______ lastnikov psov, podpirajo ga strokovnjaki.",
            "text": "<p>_______ lastnikov psov ga je vključilo v vsakodnevno nego svojega psa. _______, poleg tega pa ima veliko visokih ocen zadovoljnih lastnikov.</p>",
            "image": "shopify://shop_images/hf_20260817_204401_8fb976c0-813b-474b-ba1f-1ffe804dce15.png"
          }
        },
        "reason_6": {
          "type": "reason",
          "settings": {
            "tag": "6. razlog",
            "title": "Okus, ob katerem pes obliže skledo.",
            "text": "<p>Prašek ima okus, ki psom ustreza, in se pomeša med običajen obrok. _______ psov ga sprejme že ob prvi uporabi, zato nega zob ni več opravilo, ampak del večerje.</p>",
            "image": "shopify://shop_images/hf_20260817_204744_f3c1e2af-2223-4e98-ad23-929ca1315dbf.png"
          }
        }
      },
