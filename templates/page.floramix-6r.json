    "faq": {
      "type": "petsome-ld-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "Kako je FloraMix drugačen od navadnega probiotika?",
            "answer": "<p>Navaden probiotik doda žive kulture in tu se konča. FloraMix ima poleg živih kultur še dva postbiotika, prebiotično cikorijo, kolostrum, beta-glukane, Sophoro japonico, krilovo moko, macehe, kurkumo ter vitamina C in E, biotin in cink — skupaj 15 aktivnih sestavin, ki podpirajo tri smeri: črevesje, odpornost in kožo.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Kdaj lahko pričakujem prve spremembe?",
            "answer": "<p>Prebava se navadno odzove prva, pogosto v 1–2 tednih. Koža in dlaka potrebujeta več časa — za celovito sliko priporočamo 2–3 mesece redne uporabe. Vsak pes je drugačen.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Kako psu dam FloraMix?",
            "answer": "<p>Odmerek, prilagojen teži psa, potreseš po mokri ali suhi hrani in premešaš. Brez skrivanja v siru in brez pregovarjanja — pes samo poje svoj obrok.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Katero velikost izberem?",
            "answer": "<p>FloraMix je na voljo v treh velikostih glede na težo psa: 1–15 kg, 15–30 kg in 30+ kg. Izbereš jo v ponudbi zgoraj.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "Je primeren za vse pasme in starosti?",
            "answer": "<p>Primeren je za pse vseh pasem in velikosti. Če je psička breja ali doji oziroma pes jemlje zdravila, se pred uvedbo posvetuj z veterinarjem.</p>"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "Ali ga lahko dajem skupaj z drugimi dodatki?",
            "answer": "<p>Da. FloraMix je dopolnilna krma in se doda k običajnemu obroku. Če pes prejema zdravila, se posvetuj z veterinarjem.</p>"
          }
        },
        "q_7": {
          "type": "question",
          "settings": {
            "question": "Kaj če pri mojem psu ne bo delovalo?",
            "answer": "<p>Na voljo imaš 60 dni. Če ne boš zadovoljen, nam piši in denar ti vrnemo – tudi če je embalaža že odprta.</p>"
          }
        }
      },
