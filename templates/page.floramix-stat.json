    "reasons_b": {
      "type": "petsome-ld-reasons",
      "blocks": {
        "stats": {
          "type": "reason",
          "settings": {
            "tag": "Zakaj črevesje",
            "title": "Če ne vlagaš v pasje črevesje, ceno plača pes",
            "text": "<p>FloraMix podpira zdravo črevesje — za mirnejšo prebavo, manj težav s kožo in uravnotežen imunski odziv.</p><p><strong>VPIŠI ODSTOTEK 1 + VIR</strong> — delež pogostih težav pri psih, povezanih s črevesjem in ravnovesjem odpornosti.</p><p><strong>VPIŠI ODSTOTEK 2 + VIR</strong> — delež pasjega imunskega odziva, ki se dogaja ob črevesju.</p><p>Vpiši samo številko, za katero imaš navedljiv vir. Sicer ta blok izbriši.</p>",
            "image": "shopify://shop_images/FloraMix_SLO_03_statistika.png"
          }
        },
        "survey": {
          "type": "reason",
          "settings": {
            "tag": "Rezultati",
            "title": "Uravnovesi njegovo črevesje in poglej razliko",
            "text": "<p>Rezultati govorijo sami zase: boljše črevesje, manj nadležnih navad, srečnejši in bolj zdrav pes.</p><p><strong>VPIŠI 4 ŠTEVILKE iz naše ankete</strong> (PetLab ima tu svoje):</p><p>— X % pravi, da ga je preprosto dati že od prvega dne<br/>— X % opaža boljše delovanje črevesja<br/>— X % opaža manj praskanja, lizanja tačk ali stresanja z glavo<br/>— X % bi ga priporočilo prijatelju</p><p>Dodaj velikost vzorca in datum ankete.</p>",
            "image": "shopify://shop_images/FloraMix_benefits.png"
          }
        },
        "quality": {
          "type": "reason",
          "settings": {
            "tag": "Kakovost",
            "title": "Kakovost, ki ji lahko zaupaš",
            "text": "<p>Vsak lonček FloraMixa je narejen po najvišjih standardih:</p><p>— Vse količine izpisane na deklaraciji<br/>— 15 aktivnih sestavin<br/>— Odmerek prilagojen teži psa<br/>— Razvito v Sloveniji, izdelano v EU</p><p>krilova moka 22,44 % · kolostrum 13,3 % · Sophora japonica 5 % · maceha 3,33 % · kurkuma 3,33 % · vitamin C 16.450 mg/kg · biotin 895.000 µg/kg · vitamin E 2.500 mg/kg · cink 2.600 mg/kg.</p><p><strong>VPIŠI:</strong> PetLab tu navaja pečat NASC in testiranje pri tretji osebi. NASC je ameriško združenje in ga nimamo — vstavi naš certifikat ali analizo, sicer izbriši.</p>",
            "image": "shopify://shop_images/FloraMix_checklist.png"
          }
        }
      },
