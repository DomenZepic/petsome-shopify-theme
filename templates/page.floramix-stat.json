        "b1": {
          "type": "reason",
          "settings": {
            "tag": "Črevesje",
            "title": "Tam, kjer se večina težav začne",
            "text": "<p>Cikorija kot prebiotik hrani koristne bakterije, žive kulture <em>E. lactis</em> (200 mrd CFU/kg) in <em>B. velezensis</em> (100 mrd CFU/kg) ter <strong>dva postbiotika</strong> — <em>L. plantarum</em> CECT 9161 in <em>L. helveticus</em> HA-122 — podpirajo ravnovesje črevesja. Večina primerljivih izdelkov ima samo enega.</p>",
            "image": "shopify://shop_images/FloraMix_graf.png"
          }
        },
        "b2": {
