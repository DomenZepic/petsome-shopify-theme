    "faq": {
      "type": "petsome-ld-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "Kako dolgo naj pes jemlje probiotik?",
            "answer": "<p>FloraMix je primeren za vsakodnevno uporabo in je lahko del dolgotrajne rutine. Posebej koristen je med antibiotičnim zdravljenjem in po njem, v obdobjih stresa, ob spremembi hrane ali kadar pes kaže znake občasnih prebavnih težav. Za nasvet, prilagojen tvojemu psu, vprašaj veterinarja.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Ob katerem času dneva naj psu dam FloraMix?",
            "answer": "<p>Kadar tebi najbolj ustreza. Ker se potrese po hrani, je najpreprosteje kar ob rednem obroku.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Kaj probiotiki naredijo za psa?",
            "answer": "<p>Žive kulture podpirajo ravnovesje črevesne mikrobiote in s tem prebavo ter delovanje imunskega odziva. FloraMix poleg njih vsebuje še prebiotik, dva postbiotika, kolostrum, beta-glukane in Sophoro japonico — torej podporo tudi odpornosti in koži.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Ali FloraMix deluje?",
            "answer": "<p>FloraMix je formuliran s prebiotikom, živimi kulturami in postbiotikoma za črevesje, z beta-glukani, kolostrumom in Sophoro japonico za odpornost ter s krilovo moko, biotinom, cinkom in vitaminom E za kožo in dlako. <strong>VPIŠI</strong> podatke iz naše ankete uporabnikov, z vzorcem in datumom.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "Kako hitro probiotiki začnejo delovati pri psih?",
            "answer": "<p>Odvisno od starosti, pasme, zdravja in načina življenja psa. Prebava se navadno odzove prva, pogosto v 1–2 tednih. Za celovito sliko priporočamo 2–3 mesece redne uporabe.</p>"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "Ali ga lahko jemljejo vsi psi? So kakšne omejitve?",
            "answer": "<p>FloraMix je primeren za pse vseh velikosti in pasem. Če ima pes posebne zdravstvene težave ali znane preobčutljivosti oziroma jemlje zdravila, se pred uvedbo posvetuj z veterinarjem.</p>"
          }
        },
        "q_7": {
          "type": "question",
          "settings": {
            "question": "Kaj če pes dobi preveč FloraMixa?",
            "answer": "<p>Če si nehote dal preveč, se posvetuj z veterinarjem. Priporočeni odmerek glede na težo psa je naveden na embalaži in v razdelku Prilagojeno velikosti tvojega psa zgoraj.</p>"
          }
        },
        "q_8": {
          "type": "question",
          "settings": {
            "question": "Po čem je FloraMix drugačen od navadnega probiotičnega praška?",
            "answer": "<p>Navaden probiotik doda žive kulture in tu se konča. FloraMix ima poleg njih še prebiotično cikorijo, dva postbiotika, kolostrum, beta-glukane, Sophoro japonico, krilovo moko, macehe, kurkumo ter vitamina C in E, biotin in cink — skupaj 15 aktivnih sestavin v treh smereh.</p>"
          }
        },
        "q_9": {
          "type": "question",
          "settings": {
            "question": "Ali ga lahko jemljejo mladiči?",
            "answer": "<p><strong>VPIŠI</strong> — z deklaracije preveri, od katere starosti je FloraMix primeren.</p>"
          }
        },
        "q_10": {
          "type": "question",
          "settings": {
            "question": "Ali je primeren za mačke?",
            "answer": "<p>Ne. FloraMix je formuliran za pse in ga mačkam ne dajaj.</p>"
          }
        },
        "q_11": {
          "type": "question",
          "settings": {
            "question": "Kakšen je rok uporabe?",
            "answer": "<p><strong>VPIŠI</strong> rok uporabe z embalaže.</p>"
          }
        },
        "q_12": {
          "type": "question",
          "settings": {
            "question": "Kaj če z izdelkom nisem zadovoljen?",
            "answer": "<p>Na voljo imaš 60 dni. Če ne boš zadovoljen, nam piši in denar ti vrnemo — tudi če je embalaža že odprta.</p>"
          }
        }
      },
      "block_order": [
        "q_1",
