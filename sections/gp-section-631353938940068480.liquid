<script>
(function () {
  var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

  // prestreže vsak klik, ki bi peljal na /cart — v capture fazi, torej pred GemPagesom
  document.addEventListener('click', function (e) {
    var a = e.target.closest('a[href*="/cart"], [data-href*="/cart"]');
    if (!a) return;
    var href = a.getAttribute('href') || a.getAttribute('data-href') || '';

    var m = href.match(/\/cart\/((?:\d+:\d+,?)+)/);      // cart permalink
    if (m) {
      e.preventDefault(); e.stopPropagation();
      add(m[1].split(',').map(function (p) {
        var s = p.split(':');
        return { id: Number(s[0]), quantity: Number(s[1] || 1) };
      }));
      return;
    }
    if (/\/cart\/?($|\?)/.test(href)) {                   // navaden link na košarico
      e.preventDefault(); e.stopPropagation();
      openDrawer();
    }
  }, true);

  // če kaj drugega doda po AJAX-u, tudi odpri drawer
  var _f = window.fetch;
  window.fetch = function () {
    var u = (arguments[0] && arguments[0].url) || arguments[0] || '';
    var p = _f.apply(this, arguments);
    if (String(u).indexOf('/cart/add') > -1) p.then(function (r) { if (r.ok) setTimeout(openDrawer, 200); });
    return p;
  };

  function add(items) {
    fetch(root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/javascript' },
      body: JSON.stringify({ items: items })
    })
      .then(function (r) { return r.json(); })
      .then(function () { openDrawer(); })
      .catch(function () { window.location.href = root + 'cart'; });
  }

  function openDrawer() {
    var d = document.querySelector('cart-drawer');
    if (d && d.renderContents) {
      fetch(root + '?sections=cart-drawer,cart-icon-bubble')
        .then(function (r) { return r.json(); })
        .then(function (s) { d.classList.remove('is-empty'); d.renderContents({ sections: s }); })
        .catch(function () { if (d.open) d.open(); });
    } else {
      var i = document.querySelector('#cart-icon-bubble');
      if (i) i.click(); else window.location.href = root + 'cart';
    }
  }
})();
