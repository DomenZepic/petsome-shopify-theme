{% comment %}
  Petsome Ld: Reasons - the "N reasons why" storytelling section for landing
  pages (the "Ld" family). Repeatable "reason" blocks, each an editorial row:
  copy on the left (auto-numbered label + tag, title, body) and an image on the
  right, with a hairline divider between rows. Add or remove blocks freely -
  the numbers renumber themselves from the block order, so there is nothing to
  keep in sync by hand.

  On mobile each row stacks with the whole text block above its image.

  Uses the BODY font everywhere (no heading font) so the whole landing page
  reads as one consistent style. Fully settings-driven so translation apps
  pick up all copy.
{% endcomment %}
<style>
  #petsome-ld-reasons-{{ section.id }} {
    --pr-text: {{ section.settings.text_color }};
    --pr-accent: {{ section.settings.accent_color }};
    --pr-divider: {{ section.settings.divider_color }};
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px var(--petsome-padding-x) {{ section.settings.padding_bottom }}px;
    font-family: var(--font-body-family);
    color: var(--pr-text);
  }

  #petsome-ld-reasons-{{ section.id }} * {
    font-family: var(--font-body-family);
  }

  /* The universal rule above outranks the .material-symbols-outlined rule that
     Google Fonts ships, which would swap the icon font for the body font and
     leave raw ligature text on screen. Restore it for anything rendered inside
     this section (e.g. the Kaching UI and its JS-injected gift icons). */
  #petsome-ld-reasons-{{ section.id }} .material-symbols-outlined {
    font-family: 'Material Symbols Outlined';
  }

  #petsome-ld-reasons-{{ section.id }} p {
    margin: 0;
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reasons__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reasons__divider {
    height: 1px;
    width: 100%;
    background-color: var(--pr-divider);
    opacity: 0.2;
    border: 0;
    margin: 0;
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason__text {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    word-break: break-word;
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason__label {
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1.25;
    color: var(--pr-accent);
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason__number {
    font-size: 3.2rem;
    font-weight: 900;
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason__tag {
    font-size: 1.8rem;
    font-weight: 900;
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason__title {
    font-size: 3.2rem;
    font-weight: 900;
    line-height: 1.25;
    margin: 0;
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason__body {
    font-size: 1.7rem;
    line-height: 1.5;
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason__body p + p {
    margin-top: 1em;
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason__media {
    flex: 0 1 580px;
    max-width: 580px;
    aspect-ratio: 620 / 413;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
  }

  #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 989px) {
    /* The whole text block stacks above its image - no interleaving. */
    #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
    }

    #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason__media {
      flex: 0 0 auto;
      width: 100%;
      max-width: 580px;
      margin: 0 auto;
    }

    #petsome-ld-reasons-{{ section.id }} .petsome-ld-reasons__inner {
      gap: 40px;
    }
  }

  /* The Figma mobile frame keeps every type size here (number 32, tag 18,
     title 32, body 17) - only the section padding halves. */
  @media screen and (max-width: 749px) {
    #petsome-ld-reasons-{{ section.id }} {
      padding-top: min({{ section.settings.padding_top }}px, 40px);
      padding-bottom: min({{ section.settings.padding_bottom }}px, 40px);
    }

    #petsome-ld-reasons-{{ section.id }} .petsome-ld-reason__label {
      flex-wrap: wrap;
      gap: 4px 8px;
    }
  }
</style>

{%- if section.blocks.size > 0 -%}
  <div id="petsome-ld-reasons-{{ section.id }}" class="petsome-ld-reasons">
    <div class="petsome-ld-reasons__inner">
      {%- for block in section.blocks -%}
        {%- if forloop.index > 1 -%}
          <hr class="petsome-ld-reasons__divider">
        {%- endif -%}

        {%- liquid
          assign number = forloop.index | plus: section.settings.number_start | minus: 1
          if section.settings.pad_numbers
            assign number = number | prepend: '0' | slice: -2, 2
          endif
        -%}

        <div class="petsome-ld-reason" {{ block.shopify_attributes }}>
          <div class="petsome-ld-reason__text">
            {%- if section.settings.show_numbers or block.settings.tag != blank -%}
              <div class="petsome-ld-reason__label">
                {%- if section.settings.show_numbers -%}
                  <span class="petsome-ld-reason__number">{{ number }}</span>
                {%- endif -%}
                {%- if block.settings.tag != blank -%}
                  <span class="petsome-ld-reason__tag">{{ block.settings.tag }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h2 class="petsome-ld-reason__title">{{ block.settings.title }}</h2>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="petsome-ld-reason__body rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

          {%- if block.settings.image != blank -%}
            <div class="petsome-ld-reason__media">
              <img
                src="{{ block.settings.image | image_url: width: 1160 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 580 }} 580w,
                  {{ block.settings.image | image_url: width: 870 }} 870w,
                  {{ block.settings.image | image_url: width: 1160 }} 1160w
                "
                sizes="(min-width: 990px) 580px, min(100vw, 580px)"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Petsome Ld: Reasons",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Numbering"
    },
    {
      "type": "paragraph",
      "content": "Numbers follow the block order automatically - reorder, add or delete reasons and they renumber themselves."
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show numbers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pad_numbers",
      "label": "Pad with a leading zero",
      "info": "01, 02, 03 instead of 1, 2, 3.",
      "default": true
    },
    {
      "type": "range",
      "id": "number_start",
      "label": "Start numbering at",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#3B2F2F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Number and tag",
      "default": "#F04842"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "info": "Shown at 20% opacity.",
      "default": "#565858"
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "info": "The short label next to the number.",
          "default": "It's not your fault"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Reassure it is not their fault for this problem"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body copy",
          "default": "<p>Explain this reason in a couple of short paragraphs.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown at 3:2 (620 × 413). Recommended 1160 × 773px."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Petsome Ld: Reasons",
      "blocks": [
        { "type": "reason" },
        { "type": "reason" },
        { "type": "reason" },
        { "type": "reason" },
        { "type": "reason" },
        { "type": "reason" }
      ]
    }
  ]
}
{% endschema %}
