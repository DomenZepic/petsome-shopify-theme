<script>
(function(){
  var root = document.getElementById('bf26'); if (!root) return;
  var SIZES = JSON.parse(root.getAttribute('data-sizes'));
  var ORDER = ['FloraMix','MobiMix','DentalMix'];
  var sizeIdx = 1;
  try { var s = localStorage.getItem('bf26_size'); if (s !== null && SIZES[+s]) sizeIdx = +s; } catch(e) {}

  function giftOption(card){
    var n = +card.dataset.gifts; if (!n) return null;
    var picks = [].map.call(card.querySelectorAll('[data-bf-pick]'), function(row){
      var on = row.querySelector('[aria-checked="true"]'); return on ? on.dataset.value : card.dataset.defaultGift;
    });
    if (n === 1) return picks[0];
    picks.sort(function(a,b){ return ORDER.indexOf(a) - ORDER.indexOf(b); });
    return picks[0] === picks[1] ? '2x ' + picks[0] : picks[0] + ' + ' + picks[1];
  }
  function updateCard(card){
    var vs = card._vs || (card._vs = JSON.parse(card.querySelector('[data-bf-variants]').textContent));
    var o1 = SIZES[sizeIdx], o2 = giftOption(card);
    var v = vs.filter(function(x){ return x.o1 === o1 && (o2 === null || x.o2 === o2); })[0];
    var btn = card.querySelector('[data-bf-add]');
    if (v) { btn.dataset.variant = v.id; btn.disabled = !v.a; btn.textContent = v.a ? 'Dodaj v košarico' : 'Razprodano'; }
    var sup = card.dataset.supply.split('|');
    card.querySelector('[data-bf-supply]').textContent = sup[sizeIdx];
    card.querySelector('[data-bf-supply-size]').textContent = (card.dataset.twoDogs === '1' ? 'pri psih ' : 'pri psu ') + SIZES[sizeIdx];
  }
  function setSize(i){
    sizeIdx = i;
    try { localStorage.setItem('bf26_size', i); } catch(e) {}
    root.querySelectorAll('[data-bf-size]').forEach(function(b){ b.setAttribute('aria-checked', +b.dataset.bfSize === i ? 'true' : 'false'); });
    root.querySelectorAll('[data-bf-card]').forEach(updateCard);
  }
  root.querySelectorAll('[data-bf-size]').forEach(function(b){ b.addEventListener('click', function(){ setSize(+b.dataset.bfSize); }); });
  root.querySelectorAll('.bf-pick__opt').forEach(function(b){
    b.addEventListener('click', function(){
      b.parentNode.querySelectorAll('.bf-pick__opt').forEach(function(x){ x.setAttribute('aria-checked', x === b ? 'true' : 'false'); });
      updateCard(b.closest('[data-bf-card]'));
    });
  });

  function addToCart(id, btn){
    var label = btn.textContent; btn.disabled = true; btn.textContent = 'Dodajam…';
    fetch((window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart/add.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [{ id: +id, quantity: 1 }] })
    }).then(function(r){ return r.json().then(function(j){ if (!r.ok) throw j; return j; }); })
      .then(function(){ window.location.href = (window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart'; })
      .catch(function(err){ btn.disabled = false; btn.textContent = label; alertInline(btn, (err && (err.description || err.message)) || 'Napaka. Poskusi znova.'); });
  }
  function alertInline(btn, msg){
    var p = btn.parentNode.querySelector('.bf-card__err') || document.createElement('p');
    p.className = 'bf-card__err'; p.textContent = msg; btn.insertAdjacentElement('afterend', p);
  }
  root.querySelectorAll('[data-bf-add]').forEach(function(b){ b.addEventListener('click', function(){ addToCart(b.dataset.variant, b); }); });
  root.querySelectorAll('[data-bf-add-single]').forEach(function(b){
    b.addEventListener('click', function(){
      var ids = JSON.parse(b.closest('[data-bf-single]').getAttribute('data-bf-single'));
      addToCart(ids[Math.min(sizeIdx, ids.length - 1)], b);
    });
  });

  // Swipe dots (mobile)
  root.querySelectorAll('[data-bf-row]').forEach(function(row){
    var dots = row.nextElementSibling; if (!dots || !dots.hasAttribute('data-bf-dots')) return;
    var cards = [].slice.call(row.children).filter(function(c){ return c.matches('[data-bf-card]'); });
    cards.sort(function(a,b){ return (+getComputedStyle(a).order) - (+getComputedStyle(b).order); });
    dots.innerHTML = cards.map(function(_, i){ return '<span' + (i === 0 ? ' class="is-on"' : '') + '></span>'; }).join('');
    var raf;
    row.addEventListener('scroll', function(){
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function(){
        var mid = row.getBoundingClientRect().left + row.clientWidth / 2, best = 0, bd = 1e9;
        cards.forEach(function(c, i){ var r = c.getBoundingClientRect(); var d = Math.abs(r.left + r.width / 2 - mid); if (d < bd) { bd = d; best = i; } });
        [].forEach.call(dots.children, function(d, i){ d.classList.toggle('is-on', i === best); });
      });
    }, { passive: true });
  });

  setSize(sizeIdx);
})();
</script>

