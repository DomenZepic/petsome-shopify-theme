<style>
  .pvq-{{ section.id }}{background:{{ section.settings.bg }};padding:48px 16px}
  .pvq-{{ section.id }} .pvq-wrap{max-width:1180px;margin:0 auto}
  .pvq-{{ section.id }} h2{text-align:center;font-size:clamp(22px,3vw,30px);font-weight:800;margin:0 0 24px;color:#2b1d33}
  .pvq-{{ section.id }} .pvq-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .pvq-{{ section.id }} .pvq-card{background:#fff;border-radius:18px;padding:20px;box-shadow:0 4px 18px rgba(0,0,0,.06);display:flex;flex-direction:column;gap:12px;color:#2b1d33}
  .pvq-{{ section.id }} .pvq-tag{align-self:flex-start;font-size:12px;font-weight:800;letter-spacing:.06em;padding:4px 10px;border-radius:999px;color:#fff}
  .pvq-{{ section.id }} .pvq-stars{color:#ffcc00;letter-spacing:2px}
  .pvq-{{ section.id }} .pvq-q{font-size:15px;line-height:1.55;margin:0}
  .pvq-{{ section.id }} .pvq-who{display:flex;gap:10px;align-items:center;margin-top:auto;font-weight:700;font-size:14px}
  .pvq-{{ section.id }} .pvq-who img{width:44px;height:44px;border-radius:50%;object-fit:cover}
  @media (max-width:820px){.pvq-{{ section.id }} .pvq-grid{grid-template-columns:1fr}}
</style>
<div class="pvq-{{ section.id }}">
  <div class="pvq-wrap">
    <h2>{{ section.settings.heading }}</h2>
    <div class="pvq-grid">
      {%- for block in section.blocks -%}
        <div class="pvq-card" {{ block.shopify_attributes }}>
          <span class="pvq-tag" style="background:{{ block.settings.color }}">{{ block.settings.tag }}</span>
          <span class="pvq-stars">★★★★★</span>
          <p class="pvq-q">{{ block.settings.quote }}</p>
          <div class="pvq-who">
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy' }}{%- endif -%}
            <span>{{ block.settings.author }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Petsome: veterinar",
  "settings": [
    { "type": "color", "id": "bg", "label": "Ozadje", "default": "#ffffff" },
    { "type": "text", "id": "heading", "label": "Naslov", "default": "Kaj pravi veterinar" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Citat",
      "settings": [
        { "type": "text", "id": "tag", "label": "Izdelek", "default": "FloraMix" },
        { "type": "color", "id": "color", "label": "Barva oznake", "default": "#6b3fa0" },
        { "type": "textarea", "id": "quote", "label": "Citat" },
        { "type": "text", "id": "author", "label": "Avtor", "default": "Blaž Petelinek Ledinski, dr. vet. med." },
        { "type": "image_picker", "id": "image", "label": "Slika" }
      ]
    }
  ],
  "presets": [{ "name": "Petsome: veterinar" }]
}
{% endschema %}
