{% comment %}
  Petsome Ld: Timeline - the "first X days" results section for landing pages
  (the "Ld" family). Centered header, then a square visual on the left and a
  vertical numbered timeline on the right: a gradient circle joined by a
  connector rail, each next to a white card with a badge pill and a bold-lead
  description. An italic footnote closes the column.

  Steps are repeatable blocks and the circles number themselves from the block
  order, so adding or removing a step needs no other change. On mobile the
  visual stacks above the timeline.

  Uses the BODY font everywhere (no heading font) so the whole landing page
  reads as one consistent style. Fully settings-driven so translation apps
  pick up all copy.
{% endcomment %}
<style>
  #petsome-ld-timeline-{{ section.id }} {
    --ldt-text: {{ section.settings.text_color }};
    --ldt-accent: {{ section.settings.accent_color }};
    --ldt-accent-dark: {{ section.settings.accent_color_dark }};
    --ldt-line: {{ section.settings.line_color }};
    --ldt-card: {{ section.settings.card_color }};
    --ldt-footnote: {{ section.settings.footnote_color }};
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px var(--petsome-padding-x) {{ section.settings.padding_bottom }}px;
    font-family: var(--font-body-family);
    color: var(--ldt-text);
  }

  #petsome-ld-timeline-{{ section.id }} * {
    font-family: var(--font-body-family);
  }

  #petsome-ld-timeline-{{ section.id }} p {
    margin: 0;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  /* ---------- Header ---------- */

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 0 76px;
    text-align: center;
    word-break: break-word;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__eyebrow {
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.1;
    width: 100%;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__heading {
    font-size: 4rem;
    font-weight: 800;
    line-height: 1.1;
    width: 100%;
    margin: 0;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__subheading {
    font-size: 1.7rem;
    line-height: 1.5;
    width: 100%;
  }

  /* ---------- Body ---------- */

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__body {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 40px;
    width: 100%;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__media {
    flex: 0 1 400px;
    max-width: 400px;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__steps {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ---------- Step ---------- */

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-step {
    display: flex;
    align-items: stretch;
    gap: 12px;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-step__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    isolation: isolate;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-step__number {
    position: relative;
    z-index: 2;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: linear-gradient(180deg, var(--ldt-accent) 0%, var(--ldt-accent-dark) 100%);
    box-shadow: 0 8px 9px color-mix(in srgb, var(--ldt-accent) 50%, transparent);
    color: #ffffff;
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1;
  }

  /* Tucks the rail under the circle so the shadow reads as one piece. */
  #petsome-ld-timeline-{{ section.id }} .petsome-ld-step:not(:last-child) .petsome-ld-step__number {
    margin-bottom: -10px;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-step__line {
    position: relative;
    z-index: 1;
    flex: 1 0 0;
    min-height: 0;
    width: 2.5px;
    border-radius: 2px;
    background-color: var(--ldt-line);
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-step__card {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 16px;
    border-radius: 12px;
    background-color: var(--ldt-card);
    box-shadow: 0 8px 18px color-mix(in srgb, var(--ldt-accent) 20%, transparent);
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-step__badge {
    padding: 6px 12px;
    border-radius: 9999px;
    background-color: var(--ldt-accent);
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-step__text {
    font-size: 1.5rem;
    line-height: 1.5;
    word-break: break-word;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-step__text p + p {
    margin-top: 1em;
  }

  #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__footnote {
    font-size: 1.4rem;
    font-style: italic;
    line-height: 1.3;
    color: var(--ldt-footnote);
    width: 100%;
  }

  /* ---------- Tablet / mobile ---------- */

  @media screen and (max-width: 989px) {
    /* The visual stacks above the whole timeline. */
    #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__body {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }

    #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__media {
      flex: 0 0 auto;
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
    }

    #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__header {
      padding: 0;
    }
  }

  @media screen and (max-width: 749px) {
    #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__heading {
      font-size: 2.8rem;
    }

    #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__eyebrow,
    #petsome-ld-timeline-{{ section.id }} .petsome-ld-timeline__subheading {
      font-size: 1.6rem;
    }

    #petsome-ld-timeline-{{ section.id }} .petsome-ld-step__number {
      width: 38px;
      height: 38px;
      font-size: 1.6rem;
    }

    #petsome-ld-timeline-{{ section.id }} .petsome-ld-step__card {
      padding: 14px;
    }
  }
</style>

<div id="petsome-ld-timeline-{{ section.id }}" class="petsome-ld-timeline">
  <div class="petsome-ld-timeline__inner">
    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.subheading != blank
    -%}
      <div class="petsome-ld-timeline__header">
        {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
          <div>
            {%- if section.settings.eyebrow != blank -%}
              <p class="petsome-ld-timeline__eyebrow">{{ section.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <div class="petsome-ld-timeline__heading">{{ section.settings.heading }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="petsome-ld-timeline__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="petsome-ld-timeline__body">
      {%- if section.settings.image != blank -%}
        <div class="petsome-ld-timeline__media">
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            srcset="
              {{ section.settings.image | image_url: width: 400 }} 400w,
              {{ section.settings.image | image_url: width: 800 }} 800w
            "
            sizes="(min-width: 990px) 400px, min(100vw, 400px)"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div class="petsome-ld-timeline__steps">
        {%- for block in section.blocks -%}
          <div class="petsome-ld-step" {{ block.shopify_attributes }}>
            <div class="petsome-ld-step__rail" aria-hidden="true">
              <span class="petsome-ld-step__number">{{ forloop.index }}</span>
              {%- unless forloop.last -%}
                <span class="petsome-ld-step__line"></span>
              {%- endunless -%}
            </div>
            <div class="petsome-ld-step__card">
              {%- if block.settings.badge_text != blank -%}
                <span class="petsome-ld-step__badge">{{ block.settings.badge_text }}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="petsome-ld-step__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}

        {%- if section.settings.footnote != blank -%}
          <div class="petsome-ld-timeline__footnote">{{ section.settings.footnote }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Petsome Ld: Timeline",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "First 14 days"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>First steps happen fast</p>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Set up what the first two weeks usually look like.</p>"
    },
    {
      "type": "header",
      "content": "Visual"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown square (1:1). Recommended 800 × 800px."
    },
    {
      "type": "header",
      "content": "Footnote"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote",
      "info": "Small italic disclaimer under the steps.",
      "default": "<p>Every dog is different. This is a dietary supplement, not a treatment.</p>"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FCDDDC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#3B2F2F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "info": "Badge pills, the top of the number circles and both shadows.",
      "default": "#F8AAA7"
    },
    {
      "type": "color",
      "id": "accent_color_dark",
      "label": "Accent (circle gradient end)",
      "default": "#F47671"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Connector line",
      "default": "#FAC3C1"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "footnote_color",
      "label": "Footnote text",
      "default": "#565858"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge",
          "info": "The pill above the text, e.g. \"DAY 1-5\".",
          "default": "DAY 1-5"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "Start with a bold lead-in using the Bold (B) button, then the description.",
          "default": "<p><strong>Lorem ipsum dolor sit amet</strong>, consectetur adipiscing elit. Praesent sit amet arcu ac ipsum mattis elementum.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Petsome Ld: Timeline",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
