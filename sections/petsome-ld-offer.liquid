{% comment %}
  Petsome Ld: Offer - a PAGE-hostable version of the product offer (Kaching
  bundle tiles + weight selector + gifts + add to cart), for landing pages that
  live on /pages/ instead of /products/.

  Two columns on desktop: a manually-picked product image on the left (sticky
  while the offer scrolls) and the offer itself on the right - Trustpilot strip,
  product name, short description, weight picker, the Kaching bundle UI, then
  delivery estimate, add to cart and payment icons. On mobile the image stacks
  above the offer.

  How the Kaching part works (per Kaching's own "custom placement" docs): the
  engine is mounted as <kaching-bundle product-id="..."> inside a
  <form action="/cart/add"> with a submit button. That gives Kaching a product
  context and a form to submit, even though this isn't a product page. Our
  existing custom UI + JS (snippets/kaching-custom-display.liquid +
  assets/kaching-custom-display.js) are reused UNCHANGED - this section just
  renders that snippet with `block: section` and an explicit `product:` (the one
  picked below), and supplies the <form>, the <kaching-bundle> engine, the
  weight selector, and the ATC button that the custom UI expects to find.

  Requirements:
  - Pick a product below that has a Kaching Bundles deal configured for it.
  - Add the Kaching Bundles app block inside this section (Add block -> Apps).
  - The weight selector is built from that product's FIRST option (e.g. dog weight).
{% endcomment %}
{%- liquid
  assign offer_product = section.settings.product
  assign weight_option = offer_product.options_with_values[0]
  assign first_variant = offer_product.selected_or_first_available_variant
  assign offer_title = section.settings.heading | default: offer_product.title
-%}
<style>
  #petsome-ld-offer-{{ section.id }} {
    --ldo-text: {{ section.settings.text_color }};
    --ldo-muted: {{ section.settings.muted_text_color }};
    --ldo-secondary: {{ section.settings.secondary_color }};
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px var(--petsome-padding-x) {{ section.settings.padding_bottom }}px;
    font-family: var(--font-body-family);
    color: var(--ldo-text);
  }

  #petsome-ld-offer-{{ section.id }} * {
    font-family: var(--font-body-family);
  }

  /* The universal rule above outranks the .material-symbols-outlined rule that
     Google Fonts ships, which would swap the icon font for the body font and
     leave raw ligature text on screen. Restore it for anything rendered inside
     this section (e.g. the Kaching UI and its JS-injected gift icons). */
  #petsome-ld-offer-{{ section.id }} .material-symbols-outlined {
    font-family: 'Material Symbols Outlined';
  }

  #petsome-ld-offer-{{ section.id }} p {
    margin: 0;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 40px;
  }

  /* ---------- Product image ---------- */

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__media {
    flex: 1 0 0;
    min-width: 0;
    position: sticky;
    top: 20px;
    aspect-ratio: 1 / 1;
    border: 1px solid #eee;
    border-radius: 12px;
    overflow: hidden;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* drsljiva galerija */
  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__gallery {
    flex: 1 0 0;
    min-width: 0;
    position: sticky;
    top: 20px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__track {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    border-radius: 12px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    aspect-ratio: 1 / 1;
    border: 1px solid #eee;
    border-radius: 12px;
    overflow: hidden;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__thumbs {
    display: flex;
    gap: 8px;
    margin-top: 10px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__thumbs::-webkit-scrollbar { display: none; }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__thumb {
    flex: 0 0 62px;
    height: 62px;
    border: 1px solid #e6e6e6;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    background: #fff;
    padding: 0;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---------- Offer column ---------- */

  /* Only two children - the intro and the form - so this gap is exactly the
     space between the short description and the weight picker. */
  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__info {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__intro-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__trustpilot {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__trustpilot img {
    height: 22px;
    width: auto;
    display: block;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__trustpilot-text {
    font-size: 1.4rem;
    line-height: 1;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__title {
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: 4rem;
    line-height: 1.1;
    margin: 0;
    word-break: break-word;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__description {
    font-size: 1.7rem;
    line-height: 1.5;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__description p + p {
    margin-top: 1em;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__form {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* ---------- Weight selector ---------- */

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__weight-label {
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.4;
    margin: 0 0 4px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__weights {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 8px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__weight {
    position: relative;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__weight input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__weight label {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 16px;
    text-align: center;
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.4;
    color: var(--ldo-text);
    background-color: #ffffff;
    border: 2px solid #e7e7e7;
    border-radius: 12px;
    cursor: pointer;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__weight input:checked + label {
    border-color: var(--ldo-secondary);
    background-color: color-mix(in srgb, var(--ldo-secondary) 20%, white);
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__weight input:focus-visible + label {
    outline: 2px solid var(--ldo-text);
    outline-offset: 2px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__weight input:disabled + label {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* ---------- Zlozljive vrstice pod nakupom ---------- */

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__rows {
    margin-top: 22px;
    border-top: 1px solid rgba(0,0,0,.10);
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__row {
    border-bottom: 1px solid rgba(0,0,0,.10);
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__row > summary {
    list-style: none;
    cursor: pointer;
    padding: 19px 2px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-weight: 600;
    font-size: 1.25rem;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__row > summary::-webkit-details-marker { display: none; }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__row > summary::after {
    content: '';
    flex: 0 0 11px;
    height: 11px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform .2s ease;
    opacity: .55;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__row[open] > summary::after {
    transform: rotate(45deg);
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__row-body {
    padding: 0 2px 20px;
    font-size: 1.1rem;
    line-height: 1.6;
    opacity: .92;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__row-body p { margin: 0 0 .7em; }
  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__row-body p:last-child { margin-bottom: 0; }

  /* ---------- Delivery / ATC / payments ---------- */

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__delivery {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 1.4rem;
    line-height: 1.3;
    color: var(--ldo-muted);
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__delivery .petsome-ld-icon {
    display: block;
    flex-shrink: 0;
    font-size: 2.4rem;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__delivery p {
    margin: 0;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__atc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding: 20px;
    border: none;
    border-radius: 12px;
    background-color: {{ section.settings.atc_background }};
    color: {{ section.settings.atc_text_color }};
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.5;
    white-space: nowrap;
    cursor: pointer;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__atc .petsome-ld-icon {
    display: block;
    flex-shrink: 0;
    font-size: 2.4rem;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__atc:hover {
    opacity: 0.94;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__payments {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__payments-label {
    font-size: 1.4rem;
    line-height: 1;
    letter-spacing: 0.6px;
    color: var(--ldo-muted);
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__payments svg {
    width: 35px;
    height: auto;
  }

  /* Jump target for the hero and guarantee buttons (href="#offer"). Sits just
     outside the section wrapper, so it can't be scoped to the section id. */
  .petsome-ld-offer__anchor {
    display: block;
    scroll-margin-top: 20px;
  }

  #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__notice {
    padding: 16px;
    border: 1px dashed #b7b8b8;
    border-radius: 12px;
    font-size: 1.4rem;
    color: var(--ldo-muted);
    text-align: center;
  }

  /* ---------- Tablet / mobile ---------- */

  @media screen and (max-width: 989px) {
    #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }

    #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__media,
    #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__gallery {
      flex: 0 0 auto;
      position: static;
      top: auto;
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
    }
  }

  /* The weight options stay side by side on mobile per the design; only the
     product title (40 -> 32) and the section padding change. */
  @media screen and (max-width: 749px) {
    #petsome-ld-offer-{{ section.id }} {
      padding-top: min({{ section.settings.padding_top }}px, 40px);
      padding-bottom: min({{ section.settings.padding_bottom }}px, 40px);
    }

    #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__title {
      font-size: 3.2rem;
    }

    #petsome-ld-offer-{{ section.id }} .petsome-ld-offer__atc {
      padding: 16px 12px;
      font-size: clamp(1.2rem, 3.6vw, 1.6rem);
    }
  }
</style>

{% render 'petsome-ld-anchor-scroll' %}
{% render 'petsome-ld-anchor', id: section.settings.anchor_id | default: 'offer' %}
<div id="petsome-ld-offer-{{ section.id }}" class="petsome-ld-offer">
  <div class="petsome-ld-offer__inner">
    {%- if offer_product == blank -%}
      <div class="petsome-ld-offer__notice">
        Select a product for this offer in the theme editor, then add the "Kaching Bundles" app block inside this section (Add block &rarr; Apps) and set its product to the same one. The product must have a Kaching Bundles deal configured.
      </div>
    {%- else -%}
      {%- liquid
        assign gallery_media = offer_product.media | where: 'media_type', 'image'
        if section.settings.show_gallery == false
          assign gallery_media = empty
        endif
      -%}
      {%- if gallery_media != empty and gallery_media.size > 0 -%}
        <div class="petsome-ld-offer__gallery" id="ldg-{{ section.id }}">
          <div class="petsome-ld-offer__track" data-ldg-track>
            {%- for m in gallery_media -%}
              <div class="petsome-ld-offer__slide" id="ldg-{{ section.id }}-{{ forloop.index0 }}">
                <img
                  src="{{ m | image_url: width: 960 }}"
                  srcset="{{ m | image_url: width: 480 }} 480w, {{ m | image_url: width: 960 }} 960w"
                  sizes="(min-width: 990px) 480px, min(100vw, 480px)"
                  alt="{{ m.alt | default: offer_title | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              </div>
            {%- endfor -%}
          </div>
          {%- if gallery_media.size > 1 -%}
            <div class="petsome-ld-offer__thumbs">
              {%- for m in gallery_media -%}
                <button type="button" class="petsome-ld-offer__thumb" data-ldg-go="{{ forloop.index0 }}" aria-label="Slika {{ forloop.index }}">
                  <img src="{{ m | image_url: width: 160 }}" alt="" loading="lazy">
                </button>
              {%- endfor -%}
            </div>
            <script>
              (function(){
                var root = document.getElementById('ldg-{{ section.id }}');
                if (!root) return;
                var track = root.querySelector('[data-ldg-track]');
                root.querySelectorAll('[data-ldg-go]').forEach(function(b){
                  b.addEventListener('click', function(){
                    var i = parseInt(b.getAttribute('data-ldg-go'), 10);
                    var slide = track.children[i];
                    if (slide) track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: 'smooth' });
                  });
                });
              })();
            </script>
          {%- endif -%}
        </div>
      {%- elsif section.settings.image != blank -%}
        <div class="petsome-ld-offer__media">
          <img
            src="{{ section.settings.image | image_url: width: 960 }}"
            srcset="
              {{ section.settings.image | image_url: width: 480 }} 480w,
              {{ section.settings.image | image_url: width: 960 }} 960w
            "
            sizes="(min-width: 990px) 480px, min(100vw, 480px)"
            alt="{{ section.settings.image.alt | default: offer_title | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div class="petsome-ld-offer__info">
        <div class="petsome-ld-offer__intro">
          <div class="petsome-ld-offer__intro-head">
            {%- if section.settings.trustpilot_image != blank or section.settings.trustpilot_text != blank -%}
              <div class="petsome-ld-offer__trustpilot">
                {%- if section.settings.trustpilot_image != blank -%}
                  <img
                    src="{{ section.settings.trustpilot_image | image_url: height: 44 }}"
                    alt=""
                    width="{{ section.settings.trustpilot_image.width }}"
                    height="{{ section.settings.trustpilot_image.height }}"
                    loading="lazy"
                  >
                {%- endif -%}
                {%- if section.settings.trustpilot_text != blank -%}
                  <span class="petsome-ld-offer__trustpilot-text">{{ section.settings.trustpilot_text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if offer_title != blank -%}
              <h2 class="petsome-ld-offer__title">{{ offer_title }}</h2>
            {%- endif -%}
          </div>

          {%- if section.settings.description != blank -%}
            <div class="petsome-ld-offer__description rte">{{ section.settings.description }}</div>
          {%- endif -%}
        </div>

        <form
          action="{{ routes.cart_add_url }}"
          method="post"
          enctype="multipart/form-data"
          class="petsome-ld-offer__form"
        >
          {%- comment -%}
            Kaching engine (hidden by the custom-display CSS). The Kaching Bundles
            APP BLOCK - added by the merchant into this section - is what
            server-renders the deal-settings blob our custom UI reads. Set that
            app block's product to the same product picked in this section.
            The bare <kaching-bundle> tag is only a fallback and won't carry deal
            data on its own.
          {%- endcomment -%}
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- render block -%}
            {%- endfor -%}
          {%- else -%}
            <kaching-bundle product-id="{{ offer_product.id }}"></kaching-bundle>
          {%- endif -%}

          {%- comment -%} Variant id submitted to /cart/add; kept in sync with the weight selector below {%- endcomment -%}
          <input type="hidden" name="id" value="{{ first_variant.id }}" data-offer-variant-id>

          {%- comment -%}
            Weight selector - the custom-display JS looks this up by
            id="variant-selects-<section.id>", reads the variants JSON, and
            listens to the radio inputs (value = option1).
          {%- endcomment -%}
          {%- if weight_option and weight_option.values.size > 0 -%}
            <div id="variant-selects-{{ section.id }}">
              <script type="application/json">{{ offer_product.variants | json }}</script>
              {%- if section.settings.weight_label != blank -%}
                <p class="petsome-ld-offer__weight-label">{{ section.settings.weight_label }}</p>
              {%- endif -%}
              <div class="petsome-ld-offer__weights">
                {%- for value in weight_option.values -%}
                  {%- assign v = offer_product.variants | where: 'option1', value | first -%}
                  <div class="petsome-ld-offer__weight">
                    <input
                      type="radio"
                      id="weight-{{ section.id }}-{{ forloop.index }}"
                      name="weight-{{ section.id }}"
                      value="{{ value | escape }}"
                      data-variant-id="{{ v.id }}"
                      {% if forloop.first %}checked{% endif %}
                      {% unless v.available %}disabled{% endunless %}
                    >
                    <label for="weight-{{ section.id }}-{{ forloop.index }}">{{ value }}</label>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <div id="variant-selects-{{ section.id }}">
              <script type="application/json">{{ offer_product.variants | json }}</script>
            </div>
          {%- endif -%}

          {%- comment -%} Our custom bundle tiles + gifts UI, reused unchanged {%- endcomment -%}
          {% render 'kaching-custom-display', block: section, section: section, product: offer_product %}

          <div class="petsome-ld-offer__actions">
            {%- if section.settings.delivery_text != blank -%}
              <div class="petsome-ld-offer__delivery">
                {% render 'petsome-ld-icon', icon: 'local_shipping' %}
                {{ section.settings.delivery_text }}
              </div>
            {%- endif -%}

            <button type="submit" class="petsome-ld-offer__atc">
              {% render 'petsome-ld-icon', icon: 'shopping_bag' %}
              <span data-atc-text>{{ section.settings.atc_label | default: 'Add to cart' }}</span>
            </button>

            {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
              <div class="petsome-ld-offer__payments">
                {%- if section.settings.payments_label != blank -%}
                  <span class="petsome-ld-offer__payments-label">{{ section.settings.payments_label }}</span>
                {%- endif -%}
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag: class: 'payment-icon' }}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </form>

        {%- assign row_blocks = section.blocks | where: 'type', 'info_row' -%}
        {%- if row_blocks.size > 0 -%}
          <div class="petsome-ld-offer__rows">
            {%- for b in row_blocks -%}
              <details class="petsome-ld-offer__row"{% if b.settings.open %} open{% endif %} {{ b.shopify_attributes }}>
                <summary>{{ b.settings.heading }}</summary>
                <div class="petsome-ld-offer__row-body">{{ b.settings.content }}</div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <script>
        (function () {
          var root = document.getElementById('petsome-ld-offer-{{ section.id }}');
          if (!root) return;

          var hidden = root.querySelector('[data-offer-variant-id]');
          var radios = root.querySelectorAll('#variant-selects-{{ section.id }} input[type="radio"]');
          radios.forEach(function (radio) {
            radio.addEventListener('change', function () {
              if (radio.checked && radio.dataset.variantId && hidden) {
                hidden.value = radio.dataset.variantId;
              }
            });
          });

          {%- if section.settings.atc_show_price -%}
            /* Mirrors the Kaching header price into the button label. Read-only:
               if the custom display never renders, the label is left alone. */
            var priceEl = root.querySelector('[data-header-price-current]');
            var atcText = root.querySelector('[data-atc-text]');
            if (priceEl && atcText) {
              var baseLabel = atcText.textContent.trim();
              var syncPrice = function () {
                var price = priceEl.textContent.trim();
                atcText.textContent = price ? baseLabel + ' - ' + price : baseLabel;
              };
              new MutationObserver(syncPrice).observe(priceEl, {
                childList: true,
                characterData: true,
                subtree: true
              });
              syncPrice();
            }
          {%- endif -%}
        })();
      </script>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
