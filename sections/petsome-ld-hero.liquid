{% comment %}
  Petsome Ld: Hero - landing-page hero (the "Ld" family), built for the
  "6 reasons why" page templates. Two columns on desktop: a text column
  (social-proof pill, heading, body copy, full-width CTA with a guarantee /
  review line under it, and a "free gifts" box) next to a square lifestyle
  image. On mobile the whole text column stacks above the image. The heading
  uses the HEADING font (Literata); everything else uses the body font,
  matching the Figma design.
{% endcomment %}
{%- liquid
  assign gift_blocks = section.blocks | where: 'type', 'gift'
  assign has_gifts = false
  if section.settings.show_gifts and gift_blocks.size > 0
    assign has_gifts = true
  endif
-%}
<style>
  #petsome-ld-hero-{{ section.id }} {
    --ldh-text: {{ section.settings.text_color }};
    --ldh-muted: {{ section.settings.muted_text_color }};
    --ldh-star: {{ section.settings.star_color }};
    --ldh-accent: {{ section.settings.accent_color }};
    --ldh-gift-tile: {{ section.settings.gift_tile_color }};
    --ldh-gift-border: {{ section.settings.gift_tile_border_color }};
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px var(--petsome-padding-x) {{ section.settings.padding_bottom }}px;
    font-family: var(--font-body-family);
    color: var(--ldh-text);
  }

  #petsome-ld-hero-{{ section.id }} p {
    margin: 0;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    gap: 40px;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__media {
    flex: 0 1 580px;
    max-width: 580px;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* The intro block sits 20px apart, the CTA and gifts blocks 40px. */
  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__actions,
  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__gifts {
    margin-top: 20px;
  }

  /* ---------- Social-proof pill ---------- */

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 4px;
    border: 1px solid var(--ldh-muted);
    border-radius: 999px;
    background-color: {{ section.settings.badge_background }};
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__avatars {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__avatar {
    width: 25px;
    height: 25px;
    border-radius: 999px;
    object-fit: cover;
    display: block;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__avatar + .petsome-ld-hero__avatar {
    margin-left: -8px;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__stars {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__stars .petsome-ld-icon {
    display: block;
    flex-shrink: 0;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--ldh-star);
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__badge-text {
    flex: 1 0 0;
    min-width: 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    word-break: break-word;
  }

  /* ---------- Copy ---------- */

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__heading {
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: 4.8rem;
    line-height: 1.25;
    margin: 0;
    word-break: break-word;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__body {
    font-size: 1.7rem;
    line-height: 1.5;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__body p + p {
    margin-top: 1em;
  }

  /* ---------- CTA + reassurance ---------- */

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 20px 40px;
    border-radius: 12px;
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    font-size: 1.8rem;
    font-weight: 700;
    line-height: normal;
    text-align: center;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__reassurance {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__guarantee {
    font-size: 1.4rem;
    color: var(--ldh-muted);
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__proof {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__proof-text {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
  }

  /* ---------- Free gifts box ---------- */

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__gifts {
    border: 2px solid var(--ldh-accent);
    border-radius: 12px;
    overflow: hidden;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__gifts-heading {
    padding: 8px 12px;
    background-color: var(--ldh-accent);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: normal;
    text-align: center;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__gifts-list {
    display: flex;
    gap: 12px;
    padding: 12px;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__gift {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    padding: 12px;
    border: 2px dashed var(--ldh-gift-border);
    border-radius: 12px;
    background-color: var(--ldh-gift-tile);
    text-align: center;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__gift-icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
    display: block;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__gift-label {
    font-size: 1.4rem;
    line-height: 1.3;
  }

  #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__gift-price {
    font-size: 1.2rem;
    line-height: 1.3;
    text-decoration: line-through;
  }

  /* ---------- Tablet / mobile ---------- */

  @media screen and (max-width: 989px) {
    /* The whole text column stacks above the whole image - no interleaving. */
    #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }

    #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__media {
      flex: 0 0 auto;
      width: 100%;
      max-width: 580px;
      margin: 0 auto;
    }
  }

  /* Per the Figma mobile frame only the heading scales (48 -> 36) and the
     reassurance line stacks; the pill, CTA and gifts box keep their desktop
     sizes. The mobile hero also carries no vertical padding of its own - the
     logo bar above and the reasons section below supply the spacing. */
  @media screen and (max-width: 749px) {
    #petsome-ld-hero-{{ section.id }} {
      padding-top: 0;
      padding-bottom: 0;
    }

    #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__heading {
      font-size: 3.6rem;
    }

    #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__cta {
      padding: 16px 12px;
      font-size: clamp(1.2rem, 3.9vw, 1.7rem);
    }

    #petsome-ld-hero-{{ section.id }} .petsome-ld-hero__reassurance {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>

<div id="petsome-ld-hero-{{ section.id }}" class="petsome-ld-hero">
  <div class="petsome-ld-hero__inner">
    <div class="petsome-ld-hero__col">
      {%- if section.settings.rating_text != blank
        or section.settings.avatar_1 != blank
        or section.settings.avatar_2 != blank
        or section.settings.avatar_3 != blank
        or section.settings.show_badge_stars
      -%}
        <div class="petsome-ld-hero__badge">
          {%- if section.settings.avatar_1 != blank
            or section.settings.avatar_2 != blank
            or section.settings.avatar_3 != blank
          -%}
            <div class="petsome-ld-hero__avatars">
              {%- if section.settings.avatar_1 != blank -%}
                <img
                  class="petsome-ld-hero__avatar"
                  src="{{ section.settings.avatar_1 | image_url: width: 75 }}"
                  alt=""
                  width="25"
                  height="25"
                  loading="eager"
                >
              {%- endif -%}
              {%- if section.settings.avatar_2 != blank -%}
                <img
                  class="petsome-ld-hero__avatar"
                  src="{{ section.settings.avatar_2 | image_url: width: 75 }}"
                  alt=""
                  width="25"
                  height="25"
                  loading="eager"
                >
              {%- endif -%}
              {%- if section.settings.avatar_3 != blank -%}
                <img
                  class="petsome-ld-hero__avatar"
                  src="{{ section.settings.avatar_3 | image_url: width: 75 }}"
                  alt=""
                  width="25"
                  height="25"
                  loading="eager"
                >
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_badge_stars -%}
            <div class="petsome-ld-hero__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                {% render 'petsome-ld-icon', icon: 'star' %}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if section.settings.rating_text != blank -%}
            <p class="petsome-ld-hero__badge-text">{{ section.settings.rating_text }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="petsome-ld-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subline != blank -%}
        <div class="petsome-ld-hero__body rte">{{ section.settings.subline }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="petsome-ld-hero__actions">
          <a href="{{ section.settings.cta_url | default: '#' }}" class="petsome-ld-hero__cta">
            {{ section.settings.cta_label }}
          </a>

          {%- if section.settings.guarantee_text != blank or section.settings.proof_text != blank -%}
            <div class="petsome-ld-hero__reassurance">
              {%- if section.settings.guarantee_text != blank -%}
                <p class="petsome-ld-hero__guarantee">{{ section.settings.guarantee_text }}</p>
              {%- endif -%}
              {%- if section.settings.proof_text != blank -%}
                <div class="petsome-ld-hero__proof">
                  <div class="petsome-ld-hero__stars" aria-hidden="true">
                    {%- for i in (1..5) -%}
                      {% render 'petsome-ld-icon', icon: 'star' %}
                    {%- endfor -%}
                  </div>
                  <p class="petsome-ld-hero__proof-text">{{ section.settings.proof_text }}</p>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if has_gifts -%}
        <div class="petsome-ld-hero__gifts">
          {%- if section.settings.gifts_heading != blank -%}
            <p class="petsome-ld-hero__gifts-heading">{{ section.settings.gifts_heading }}</p>
          {%- endif -%}
          <div class="petsome-ld-hero__gifts-list">
            {%- for block in gift_blocks -%}
              <div class="petsome-ld-hero__gift" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <img
                    class="petsome-ld-hero__gift-icon"
                    src="{{ block.settings.icon | image_url: width: 120 }}"
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                  >
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <p class="petsome-ld-hero__gift-label">{{ block.settings.label }}</p>
                {%- endif -%}
                {%- if block.settings.price != blank -%}
                  <p class="petsome-ld-hero__gift-price">{{ block.settings.price }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="petsome-ld-hero__media">
        <img
          src="{{ section.settings.image | image_url: width: 1160 }}"
          srcset="
            {{ section.settings.image | image_url: width: 580 }} 580w,
            {{ section.settings.image | image_url: width: 870 }} 870w,
            {{ section.settings.image | image_url: width: 1160 }} 1160w
          "
          sizes="(min-width: 990px) 580px, min(100vw, 580px)"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Petsome Ld: Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Social proof pill"
    },
    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "Avatar 1",
      "info": "Small round customer/dog photos. Recommended 100 × 100px."
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "Avatar 2"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "Avatar 3"
    },
    {
      "type": "checkbox",
      "id": "show_badge_stars",
      "label": "Show 5 stars in the pill",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Pill text",
      "default": "Used by over a 3.500 dogs across Europe"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>6 reasons why Dog Trainers swear on this dog joint supplement</p>"
    },
    {
      "type": "richtext",
      "id": "subline",
      "label": "Body copy",
      "default": "<p>Introduce the problem really well - detailed description of the problem, how they tried everything, nothing works.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Shown square (1:1). Recommended 1160 × 1160px."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "START YOUR DOG-TRAINER ROUTINE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "60-day money-back guarantee"
    },
    {
      "type": "text",
      "id": "proof_text",
      "label": "Review text",
      "info": "Shown next to 5 stars under the button.",
      "default": "Over 10.000 satisfied customers"
    },
    {
      "type": "header",
      "content": "Free gifts"
    },
    {
      "type": "checkbox",
      "id": "show_gifts",
      "label": "Show free gifts box",
      "default": true
    },
    {
      "type": "text",
      "id": "gifts_heading",
      "label": "Gifts heading",
      "default": "FREE GIFTS WITH YOUR FIRST ORDER!"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#3B2F2F"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text / pill border",
      "default": "#565858"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Pill background",
      "default": "#FDFDFC"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars",
      "default": "#FF9A0A"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#3B2F2F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gifts box accent",
      "default": "#F8AAA7"
    },
    {
      "type": "color",
      "id": "gift_tile_color",
      "label": "Gift tile background",
      "default": "#F1E1D5"
    },
    {
      "type": "color",
      "id": "gift_tile_border_color",
      "label": "Gift tile border",
      "default": "#B7B8B8"
    }
  ],
  "blocks": [
    {
      "type": "gift",
      "name": "Gift",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Recommended 120 × 120px, transparent PNG."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "2x eBook"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Crossed-out value",
          "default": "35,90 €"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Petsome Ld: Hero",
      "blocks": [
        { "type": "gift" },
        { "type": "gift" },
        { "type": "gift" }
      ]
    }
  ]
}
{% endschema %}
