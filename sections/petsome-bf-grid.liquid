{%- comment -%}
  Petsome Black Friday paketi. Kartice v stilu Coffee 2.0: Duo / Zaloga 3+ mesece (izpostavljena) / 6-mesečna zaloga,
  pod njimi Paket Zdrav pes. Cene in prečrtane cene pridejo iz Shopify Bundles izdelkov.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  .bfg-{{ section.id }}{background:{{ s.bg }};padding:0 20px 72px;color:#161616;overflow-x:hidden;--serif:var(--font-heading-family,Georgia,serif)}
  .bfg-{{ section.id }} .bfg-top>*,.bfg-{{ section.id }} .bfg-grid>*,.bfg-{{ section.id }} .bfg-trio>*{min-width:0}
  .bfg-{{ section.id }} picture{display:block} .bfg-{{ section.id }} img{max-width:100%}
  .bfg-{{ section.id }} [hidden]{display:none!important}
  .bfg-{{ section.id }} .bfg-wrap{max-width:1160px;margin:0 auto;text-align:center}
  .bfg-{{ section.id }} .bfg-bar{background:#111;color:#fff;font-size:12px;letter-spacing:.16em;text-transform:uppercase;padding:11px 16px;margin:0 -20px 56px;text-align:center}
  .bfg-{{ section.id }} .bfg-top{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center;margin:0 0 96px;text-align:left}
  .bfg-{{ section.id }} .bfg-top img{width:100%;height:auto;display:block;border-radius:4px}
  .bfg-{{ section.id }} .bfg-eyebrow{font-size:12px;letter-spacing:.22em;text-transform:uppercase;margin:0 0 18px;color:#161616}
  .bfg-{{ section.id }} .bfg-h1{font-family:var(--serif);font-weight:400;font-size:clamp(36px,4.6vw,58px);line-height:1.05;margin:0 0 20px;letter-spacing:-.01em;color:#161616}
  .bfg-{{ section.id }} .bfg-h1 p{margin:0}
  .bfg-{{ section.id }} .bfg-h1 em{display:block;font-style:italic;color:{{ s.red }}}
  .bfg-{{ section.id }} .bfg-sub{font-size:17px;line-height:1.55;color:#3a3a3a;margin:0 0 22px;max-width:440px}
  .bfg-{{ section.id }} .bfg-cd{font-size:14px;color:#3a3a3a;margin:0 0 28px}
  .bfg-{{ section.id }} .bfg-cd b{color:#161616;font-variant-numeric:tabular-nums;font-weight:700}
  .bfg-{{ section.id }} .bfg-cta{display:inline-block;border:1px solid #161616;background:#161616;color:#fff;font-size:13px;letter-spacing:.16em;text-transform:uppercase;padding:18px 40px;border-radius:2px;cursor:pointer;transition:background .2s,color .2s}
  .bfg-{{ section.id }} .bfg-cta:hover{background:transparent;color:#161616}
  .bfg-{{ section.id }} .bfg-usp{margin-top:22px;font-size:13px;color:#5a5a5a;letter-spacing:.02em}
  .bfg-{{ section.id }} .bfg-usp span+span:before{content:"·";margin:0 10px;color:#a9a29a}
  .bfg-{{ section.id }} .bfg-trust{font-size:13px;color:#5a5a5a;margin:10px 0 0}
  .bfg-{{ section.id }} .bfg-kicker{font-size:12px;letter-spacing:.22em;text-transform:uppercase;margin:0 0 14px;color:#161616}
  .bfg-{{ section.id }} .bfg-h2,.bfg-{{ section.id }} .bfg-trio-h{font-family:var(--serif);font-weight:400;font-size:clamp(28px,3.4vw,42px);line-height:1.1;margin:0 0 30px;color:#161616!important;-webkit-text-fill-color:#161616!important;opacity:1!important}
  .bfg-{{ section.id }} .bfg-trio-h{margin:110px 0 34px}
  .bfg-{{ section.id }} .bfg-tabs{display:inline-flex;gap:34px;margin:0 0 48px;border-bottom:1px solid #d9d1c7;padding:0 6px}
  .bfg-{{ section.id }} .bfg-tab{border:0;background:none;padding:0 0 12px;margin-bottom:-1px;font-size:14px;letter-spacing:.12em;text-transform:uppercase;color:#8a8279;cursor:pointer;border-bottom:2px solid transparent}
  .bfg-{{ section.id }} .bfg-tab[aria-selected="true"]{color:#161616;border-bottom-color:#161616}
  .bfg-{{ section.id }} .bfg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:stretch}
  .bfg-{{ section.id }} .bfg-card{background:#fff;border:1px solid #e7dfd5;border-radius:4px;padding:14px 14px 22px;display:flex;flex-direction:column;text-align:left;position:relative}
  .bfg-{{ section.id }} .bfg-card.is-hero{border-color:#161616;box-shadow:0 24px 48px -28px rgba(0,0,0,.35)}
  .bfg-{{ section.id }} .bfg-ribbon{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#fff;background:#161616;margin:-14px -14px 14px;padding:10px;text-align:center;border-radius:3px 3px 0 0}
  .bfg-{{ section.id }} .bfg-img{position:relative;aspect-ratio:1/1;overflow:hidden;margin-bottom:18px;background:#111;border-radius:2px}
  .bfg-{{ section.id }} .bfg-img img{width:100%;height:100%;object-fit:cover;display:block}
  .bfg-{{ section.id }} .bfg-pct{position:absolute;top:12px;left:12px;background:#fff;color:#161616;font-size:12px;letter-spacing:.08em;font-weight:700;padding:6px 10px;border-radius:2px}
  .bfg-{{ section.id }} .bfg-name{font-family:var(--serif);font-size:26px;line-height:1.15;margin:0 0 6px;color:#161616}
  .bfg-{{ section.id }} .bfg-unit{font-size:13px;color:{{ s.red }};letter-spacing:.04em;margin:0 0 12px;font-weight:600}
  .bfg-{{ section.id }} .bfg-what{font-size:14px;color:#4a4a4a;margin:0 0 6px}
  .bfg-{{ section.id }} .bfg-gifts{list-style:none;padding:0;margin:0 0 20px;font-size:14px;color:#4a4a4a}
  .bfg-{{ section.id }} .bfg-gifts li:before{content:"+ ";color:#161616}
  .bfg-{{ section.id }} .bfg-price{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;margin:auto 0 4px;padding-top:14px;border-top:1px solid #efe8df}
  .bfg-{{ section.id }} .bfg-price .now{font-size:24px;font-weight:700;color:#161616}
  .bfg-{{ section.id }} .bfg-price s{color:#9a938b;font-size:15px}
  .bfg-{{ section.id }} .bfg-sv{font-size:13px;color:#1d6b3a;margin:0 0 16px}
  .bfg-{{ section.id }} .bfg-btn{border:1px solid #161616;background:#161616;color:#fff;font-size:13px;letter-spacing:.16em;text-transform:uppercase;padding:17px;border-radius:2px;cursor:pointer;width:100%;transition:background .2s,color .2s}
  .bfg-{{ section.id }} .bfg-btn:hover{background:#fff;color:#161616}
  .bfg-{{ section.id }} .bfg-btn[disabled]{opacity:.5}
  .bfg-{{ section.id }} .bfg-trio{max-width:960px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:stretch}
  .bfg-{{ section.id }} .bfg-trio .bfg-img{margin:0;aspect-ratio:auto;min-height:100%}
  .bfg-{{ section.id }} .bfg-guar{margin:64px auto 0;max-width:620px;display:flex;gap:16px;align-items:center;justify-content:center;font-size:14px;color:#4a4a4a;text-align:left}
  .bfg-{{ section.id }} .bfg-guar p{margin:0}
  .bfg-{{ section.id }} .bfg-singles-h{margin-top:110px}
  .bfg-{{ section.id }} .bfg-o{display:flex;align-items:center;gap:10px;border:1px solid #e7dfd5;border-radius:2px;padding:12px;margin:0 0 8px;cursor:pointer;background:#fff}
  .bfg-{{ section.id }} .bfg-o:has(input:checked){border-color:#161616}
  .bfg-{{ section.id }} .bfg-o input{accent-color:#161616}
  .bfg-{{ section.id }} .bfg-o-l{flex:1;font-size:14px;line-height:1.35}
  .bfg-{{ section.id }} .bfg-o-l small{display:block;color:#6a6a6a;font-size:12px}
  .bfg-{{ section.id }} .bfg-o-s{font-style:normal;color:{{ s.red }};font-size:12px;font-weight:700;margin-left:4px;white-space:nowrap}
  .bfg-{{ section.id }} .bfg-o-p{text-align:right;font-weight:700;font-size:15px;white-space:nowrap}
  .bfg-{{ section.id }} .bfg-o-p s{display:block;font-weight:400;color:#9a938b;font-size:12px}
  .bfg-{{ section.id }} .bfg-singles .bfg-img{background:#f3ede6}
  .bfg-{{ section.id }} .bfg-singles .bfg-btn{margin-top:12px}
  @media (max-width:820px){
    .bfg-{{ section.id }}{padding:0 16px 56px}
    .bfg-{{ section.id }} .bfg-bar{margin:0 -16px 0}
    .bfg-{{ section.id }} .bfg-top{grid-template-columns:1fr;gap:26px;text-align:center;margin:0 -16px 64px}
    .bfg-{{ section.id }} .bfg-top-txt{order:-1;padding:36px 20px 0}
    .bfg-{{ section.id }} .bfg-top img{border-radius:0}
    .bfg-{{ section.id }} .bfg-sub{margin-left:auto;margin-right:auto}
    .bfg-{{ section.id }} .bfg-grid{grid-template-columns:1fr;gap:20px}
    .bfg-{{ section.id }} .bfg-card{max-width:420px;width:100%;margin:0 auto}
    .bfg-{{ section.id }} .bfg-card.is-hero{order:-1}
    .bfg-{{ section.id }} .bfg-trio{grid-template-columns:1fr;max-width:420px}
    .bfg-{{ section.id }} .bfg-trio .bfg-img{aspect-ratio:1/1}
    .bfg-{{ section.id }} .bfg-tabs{gap:22px}
  }
</style>

<div class="bfg-{{ section.id }}" id="bfg-{{ section.id }}">
  {%- if s.bar_text != blank -%}<div class="bfg-bar">{{ s.bar_text }}</div>{%- endif -%}
  <div class="bfg-wrap">
    <div class="bfg-top">
      {%- if s.hero_d != blank -%}
        <picture>
          {%- if s.hero_m != blank -%}<source media="(max-width:820px)" srcset="{{ s.hero_m | asset_img_url: '900x' }}">{%- endif -%}
          <img src="{{ s.hero_d | asset_img_url: '1400x' }}" alt="{{ s.kicker | escape }}" width="1400" height="782">
        </picture>
      {%- endif -%}
      <div class="bfg-top-txt">
        {%- if s.badge != blank -%}<p class="bfg-eyebrow">{{ s.badge }}</p>{%- endif -%}
        <div class="bfg-h1">{{ s.heading }}</div>
        {%- if s.sub != blank -%}<p class="bfg-sub">{{ s.sub }}</p>{%- endif -%}
        {%- if s.deadline != blank -%}
          <p class="bfg-cd" data-end="{{ s.deadline }}">{{ s.cd_label }} <b><span data-d>0</span> {{ s.cd_d }} <span data-h>00</span> {{ s.cd_h }} <span data-m>00</span> {{ s.cd_m }} <span data-s>00</span> {{ s.cd_s }}</b></p>
        {%- endif -%}
        <button type="button" class="bfg-cta" onclick="var t=document.getElementById('bfg-packs-{{ section.id }}');if(t){window.scrollTo({top:t.getBoundingClientRect().top+window.pageYOffset-90,behavior:'smooth'});}">{{ s.top_cta }}</button>
        {%- if s.usp != blank -%}<div class="bfg-usp">{%- assign ul = s.usp | split: ',' -%}{%- for u in ul -%}<span>{{ u | strip }}</span>{%- endfor -%}</div>{%- endif -%}
        {%- if s.trust != blank -%}<p class="bfg-trust">★★★★★ &nbsp;{{ s.trust }}</p>{%- endif -%}
      </div>
    </div>

    <p class="bfg-kicker" id="bfg-packs-{{ section.id }}">{{ s.kicker }}</p>
    <h2 class="bfg-h2">{{ s.heading2 }}</h2>

    <div class="bfg-tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button class="bfg-tab" role="tab" type="button" data-tab="{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <div class="bfg-grid" data-panel="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
        {%- for i in (1..3) -%}
          {%- liquid
            if i == 1
              assign p = b.duo
              assign nm = b.duo_name
              assign what = b.duo_text
              assign gifts = b.duo_gifts
              assign qty = 2
              assign hero = false
            elsif i == 2
              assign p = b.month
              assign nm = b.month_name
              assign what = b.month_text
              assign gifts = b.month_gifts
              assign qty = 4
              assign hero = true
            else
              assign p = b.six
              assign nm = b.six_name
              assign what = b.six_text
              assign gifts = b.six_gifts
              assign qty = 6
              assign hero = false
            endif
          -%}
          {%- if p != blank -%}
            {%- liquid
              assign v = p.selected_or_first_available_variant
              assign cmp = v.compare_at_price | default: v.price
              assign saved = cmp | minus: v.price
              assign pct = 0
              if cmp > 0
                assign pct = saved | times: 100 | divided_by: cmp
              endif
              assign unit = v.price | divided_by: qty
            -%}
            <div class="bfg-card{% if hero %} is-hero{% endif %}">
              {%- if hero -%}<div class="bfg-ribbon">{{ s.hero_label }}</div>{%- endif -%}
              <div class="bfg-img">
                {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}
                {%- if pct > 0 -%}<span class="bfg-pct">−{{ pct }} %</span>{%- endif -%}
              </div>
              <div class="bfg-name">{{ nm }}</div>
              <p class="bfg-unit">{{ unit | money }} / {{ s.unit_label }}</p>
              <p class="bfg-what">{{ what }}</p>
              {%- if gifts != blank -%}
                <ul class="bfg-gifts">{%- assign gl = gifts | split: ',' -%}{%- for g in gl -%}<li>{{ g | strip }}</li>{%- endfor -%}</ul>
              {%- endif -%}
              <div class="bfg-price"><span class="now">{{ v.price | money }}</span>{%- if saved > 0 -%}<s>{{ cmp | money }}</s>{%- endif -%}</div>
              {%- if saved > 0 -%}<p class="bfg-sv">{{ s.saved_label }} {{ saved | money }}</p>{%- endif -%}
              <button class="bfg-btn" type="button" data-variant="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
                {%- if v.available -%}{{ s.btn_label }}{%- else -%}{{ s.soldout_label }}{%- endif -%}
              </button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}

    {%- assign t = s.trio -%}
    {%- if t != blank -%}
      {%- liquid
        assign v = t.selected_or_first_available_variant
        assign cmp = v.compare_at_price | default: v.price
        assign saved = cmp | minus: v.price
        assign pct = 0
        if cmp > 0
          assign pct = saved | times: 100 | divided_by: cmp
        endif
      -%}
      <h2 class="bfg-trio-h">{{ s.trio_heading }}</h2>
      <div class="bfg-trio">
        <div class="bfg-img">
          {%- if t.featured_image -%}{{ t.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: t.title }}{%- endif -%}
          {%- if pct > 0 -%}<span class="bfg-pct">−{{ pct }} %</span>{%- endif -%}
        </div>
        <div class="bfg-card">
          <div class="bfg-name">{{ t.title | split: ' (' | first }}</div>
          <p class="bfg-what">{{ s.trio_text }}</p>
          {%- if s.trio_gifts != blank -%}
            <ul class="bfg-gifts">{%- assign gl = s.trio_gifts | split: ',' -%}{%- for g in gl -%}<li>{{ g | strip }}</li>{%- endfor -%}</ul>
          {%- endif -%}
          <div class="bfg-price"><span class="now">{{ v.price | money }}</span>{%- if saved > 0 -%}<s>{{ cmp | money }}</s>{%- endif -%}</div>
              {%- if saved > 0 -%}<p class="bfg-sv">{{ s.saved_label }} {{ saved | money }}</p>{%- endif -%}
          <button class="bfg-btn" type="button" data-variant="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
            {%- if v.available -%}{{ s.btn_label }}{%- else -%}{{ s.soldout_label }}{%- endif -%}
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- if s.guarantee != blank -%}
      <div class="bfg-guar">
        {%- if s.guarantee_img != blank -%}{{ s.guarantee_img | image_url: width: 140 | image_tag: width: 60, height: 60, loading: 'lazy' }}{%- endif -%}
        <div>{{ s.guarantee }}</div>
      </div>
    {%- endif -%}
    {%- if s.single_1 != blank or s.single_2 != blank or s.single_3 != blank -%}
      <h2 class="bfg-h2 bfg-singles-h">{{ s.singles_heading }}</h2>
      <div class="bfg-grid bfg-singles">
        {%- for n in (1..3) -%}
          {%- liquid
            assign k1 = 'single_' | append: n
            assign k3 = k1 | append: '_3x'
            assign k6 = k1 | append: '_6x'
            assign kt = k1 | append: '_text'
            assign sp = s[k1]
            assign p3 = s[k3]
            assign p6 = s[k6]
            assign stext = s[kt]
          -%}
          {%- if sp != blank -%}
            {%- liquid
              assign v1 = sp.selected_or_first_available_variant
              assign base = v1.price
            -%}
            <div class="bfg-card bfg-opt" data-opt>
              <a class="bfg-img" href="{{ sp.url }}">{%- if sp.featured_image -%}{{ sp.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: sp.title }}{%- endif -%}</a>
              <div class="bfg-name">{{ sp.title }}</div>
              <p class="bfg-what">{{ stext }}</p>
              <label class="bfg-o"><input type="radio" name="o-{{ section.id }}-{{ n }}" value="{{ v1.id }}"><span class="bfg-o-l"><b>1x</b> {{ sp.title }}<small>{{ base | money }} / {{ s.unit_label }}</small></span><span class="bfg-o-p">{{ base | money }}</span></label>
              {%- assign qs = '3,6' | split: ',' -%}
              {%- for qq in qs -%}
                {%- liquid
                  if qq == '3'
                    assign pp = p3
                    assign q = 3
                    assign gifts = s.gift_3
                  else
                    assign pp = p6
                    assign q = 6
                    assign gifts = s.gift_6
                  endif
                -%}
                {%- if pp != blank -%}
                  {%- liquid
                    assign vv = pp.selected_or_first_available_variant
                    assign full = base | times: q
                    assign svd = full | minus: vv.price
                    assign pc = svd | times: 100 | divided_by: full
                    assign per = vv.price | divided_by: q
                  -%}
                  <label class="bfg-o"><input type="radio" name="o-{{ section.id }}-{{ n }}" value="{{ vv.id }}" {% if q == 3 %}checked{% endif %}><span class="bfg-o-l"><b>{{ q }}x</b> {{ sp.title }} <em class="bfg-o-s">{{ s.save_label }} {{ pc }} %</em><small>{{ per | money }} / {{ s.unit_label }} · 🎁 {{ gifts }}</small></span><span class="bfg-o-p">{{ vv.price | money }}<s>{{ full | money }}</s></span></label>
                {%- endif -%}
              {%- endfor -%}
              <button class="bfg-btn" type="button" data-opt-add>{{ s.btn_label }}</button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
(function(){
  var root=document.getElementById('bfg-{{ section.id }}'); if(!root) return;
  root.querySelectorAll('.bfg-tab').forEach(function(t){
    t.addEventListener('click',function(){
      root.querySelectorAll('.bfg-tab').forEach(function(x){x.setAttribute('aria-selected','false')});
      t.setAttribute('aria-selected','true');
      root.querySelectorAll('[data-panel]').forEach(function(p){p.hidden = p.getAttribute('data-panel')!==t.getAttribute('data-tab')});
    });
  });
  var cd=root.querySelector('.bfg-cd');
  if(cd){var end=new Date(cd.getAttribute('data-end')).getTime();var f=function(n){return n<10?'0'+n:n};var tick=function(){var x=Math.max(0,end-Date.now())/1000;cd.querySelector('[data-d]').textContent=Math.floor(x/86400);cd.querySelector('[data-h]').textContent=f(Math.floor(x%86400/3600));cd.querySelector('[data-m]').textContent=f(Math.floor(x%3600/60));cd.querySelector('[data-s]').textContent=f(Math.floor(x%60));};tick();setInterval(tick,1000);}
  var rootUrl=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';
  function addToCart(id,btn){
    btn.disabled=true;
    var cd=document.querySelector('cart-drawer');
    var body={items:[{id:parseInt(id,10),quantity:1}]};
    var canDrawer=cd && typeof cd.renderContents==='function' && typeof cd.getSectionsToRender==='function';
    if(canDrawer){ body.sections=cd.getSectionsToRender().map(function(s){return s.id}); body.sections_url=window.location.pathname; }
    fetch(rootUrl+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})
      .then(function(r){return r.json()})
      .then(function(state){
        btn.disabled=false;
        if(state && state.status){ alert(state.description||state.message||'Napaka'); return; }
        if(canDrawer){
          try{
            if(cd.classList.contains('is-empty')) cd.classList.remove('is-empty');
            cd.renderContents(state);
            document.dispatchEvent(new CustomEvent('cart:refresh',{bubbles:true}));
            return;
          }catch(e){}
        }
        window.location.href=rootUrl+'cart';
      })
      .catch(function(){btn.disabled=false; window.location.href=rootUrl+'cart';});
  }
  root.querySelectorAll('[data-opt-add]').forEach(function(b){
    b.addEventListener('click',function(){
      var c=b.closest('[data-opt]').querySelector('input:checked'); if(c) addToCart(c.value,b);
    });
  });
  root.querySelectorAll('.bfg-btn[data-variant]').forEach(function(b){
    b.addEventListener('click',function(){ addToCart(b.getAttribute('data-variant'),b); });
  });
})();
</script>

{% schema %}
{
  "name": "Petsome: BF paketi",
  "settings": [
    { "type": "color", "id": "bg", "label": "Ozadje", "default": "#0d0d10" },
    { "type": "color", "id": "accent", "label": "Zlata (poudarek)", "default": "#e3b65b" },
    { "type": "color", "id": "red", "label": "Rdeča (značke)", "default": "#e01e1e" },
    { "type": "color", "id": "btn", "label": "Gumbi", "default": "#e8620c" },
