{%- comment -%}
  Petsome Black Friday paketi. Kartice v stilu Coffee 2.0: Duo / Zaloga 3+ mesece (izpostavljena) / 6-mesečna zaloga,
  pod njimi Paket Zdrav pes. Cene in prečrtane cene pridejo iz Shopify Bundles izdelkov.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  .bfg-{{ section.id }}{background:{{ s.bg }};padding:0 16px 56px;color:#1a1a1a;font-family:inherit;overflow-x:hidden}
  .bfg-{{ section.id }} .bfg-top>*,.bfg-{{ section.id }} .bfg-grid>*,.bfg-{{ section.id }} .bfg-trio>*{min-width:0}
  .bfg-{{ section.id }} picture{display:block}
  .bfg-{{ section.id }} img{max-width:100%}
  .bfg-{{ section.id }} .bfg-wrap{max-width:1180px;margin:0 auto;text-align:center}
  .bfg-{{ section.id }} .bfg-bar{background:#111;color:#fff;text-align:center;font-weight:800;font-size:14px;padding:10px 16px;margin:0 -16px 32px;letter-spacing:.02em}
  .bfg-{{ section.id }} .bfg-top{display:grid;grid-template-columns:1.15fr 1fr;gap:40px;align-items:center;margin:0 0 48px;text-align:left}
  .bfg-{{ section.id }} .bfg-top img{width:100%;height:auto;border-radius:18px;display:block;box-shadow:0 14px 40px rgba(0,0,0,.18)}
  .bfg-{{ section.id }} .bfg-trust{display:inline-flex;gap:8px;align-items:center;font-weight:600;font-size:15px;margin-bottom:14px;opacity:.9}
  .bfg-{{ section.id }} .bfg-trust span{color:#f5a623;letter-spacing:2px}
  .bfg-{{ section.id }} .bfg-h1{font-family:var(--font-heading-family,Georgia,serif);font-size:clamp(36px,4.6vw,58px);line-height:1.05;margin:0 0 16px;font-weight:400;letter-spacing:-.01em;color:#1a1a1a;overflow-wrap:break-word}
  .bfg-{{ section.id }} .bfg-h1 p{margin:0}
  .bfg-{{ section.id }} .bfg-h1 em{display:block;font-style:italic;color:{{ s.red }}}
  .bfg-{{ section.id }} .bfg-sub{font-size:17px;opacity:.85;margin:0 0 22px}
  .bfg-{{ section.id }} .bfg-cta{display:inline-block;border:0;border-radius:6px;background:#111;color:#fff;font-weight:800;font-size:15px;letter-spacing:.04em;text-transform:uppercase;padding:17px 44px;cursor:pointer}
  .bfg-{{ section.id }} .bfg-cta:hover{background:#2a2a2a}
  .bfg-{{ section.id }} .bfg-cta span{display:none}
  .bfg-{{ section.id }} .bfg-badge{display:inline-block;background:#111;color:#fff;font-weight:800;font-size:12px;letter-spacing:.16em;padding:7px 14px;border-radius:4px;margin-bottom:16px}
  .bfg-{{ section.id }} .bfg-cd{display:flex;gap:8px;margin:0 0 22px}
  .bfg-{{ section.id }} .bfg-cd div{background:#fff;border:1px solid rgba(20,20,20,.08);border-radius:12px;min-width:64px;padding:8px 6px;text-align:center;box-shadow:0 6px 16px rgba(60,40,20,.08)}
  .bfg-{{ section.id }} .bfg-cd b{display:block;font-size:24px;font-weight:900;line-height:1.1;font-variant-numeric:tabular-nums}
  .bfg-{{ section.id }} .bfg-cd small{font-size:10.5px;letter-spacing:.12em;opacity:.6;text-transform:uppercase}
  .bfg-{{ section.id }} .bfg-usp{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:18px;font-size:14px;font-weight:600;opacity:.85}
  .bfg-{{ section.id }} .bfg-usp span:before{content:"✓ ";color:#1d7a3a;font-weight:900}
  .bfg-{{ section.id }} .bfg-kicker{font-size:13px;font-weight:800;letter-spacing:.14em;color:#111;margin:0 0 4px}
  .bfg-{{ section.id }} .bfg-h2{font-size:clamp(24px,3.2vw,36px);margin:0 0 18px;font-weight:900;color:#1a1a1a!important;-webkit-text-fill-color:#1a1a1a!important;opacity:1!important}
  .bfg-{{ section.id }} .bfg-tabs{display:inline-flex;background:#fff;box-shadow:0 2px 12px rgba(0,0,0,.08);border-radius:999px;padding:5px;gap:4px;margin:0 0 34px;flex-wrap:wrap;justify-content:center}
  .bfg-{{ section.id }} .bfg-tab{border:0;background:transparent;padding:10px 22px;border-radius:999px;font-weight:700;font-size:15px;cursor:pointer;color:#1a1a1a}
  .bfg-{{ section.id }} .bfg-tab[aria-selected="true"]{background:#141416;color:#fff}
  .bfg-{{ section.id }} .bfg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;align-items:stretch;padding-top:22px}
  .bfg-{{ section.id }} .bfg-card{background:#fff;color:#1a1a1a;border-radius:20px;padding:16px 16px 20px;position:relative;display:flex;flex-direction:column;text-align:left;border:1px solid rgba(20,20,20,.07);box-shadow:0 1px 2px rgba(20,20,20,.04),0 12px 32px rgba(60,40,20,.10);transition:transform .2s ease,box-shadow .2s ease}
  .bfg-{{ section.id }} .bfg-card:hover{transform:translateY(-3px);box-shadow:0 2px 4px rgba(20,20,20,.05),0 18px 44px rgba(60,40,20,.16)}
  .bfg-{{ section.id }} .bfg-card.is-hero{border:2px solid #111;box-shadow:0 22px 50px rgba(60,40,20,.18);transform:translateY(-12px)}
  .bfg-{{ section.id }} .bfg-card.is-hero:hover{transform:translateY(-15px)}
  .bfg-{{ section.id }} .bfg-ribbon{position:absolute;top:-15px;left:50%;transform:translateX(-50%);background:#111;color:#fff;font-weight:800;letter-spacing:.12em;font-size:12px;padding:8px 18px;border-radius:6px;white-space:nowrap;z-index:2}
  .bfg-{{ section.id }} .bfg-img{position:relative;aspect-ratio:1/1;border-radius:14px;overflow:hidden;margin-bottom:16px;background:#111;box-shadow:inset 0 0 0 1px rgba(0,0,0,.05)}
  .bfg-{{ section.id }} .bfg-img img{width:100%;height:100%;object-fit:cover;display:block}
  .bfg-{{ section.id }} .bfg-pct{position:absolute;top:10px;left:10px;box-shadow:0 4px 10px rgba(224,30,30,.3);background:{{ s.red }};color:#fff;font-weight:800;font-size:13px;padding:6px 12px;border-radius:999px}
  .bfg-{{ section.id }} .bfg-seal{position:absolute;top:8px;right:8px;width:96px;height:96px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#f3d48a,#b8862e 70%);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;line-height:1.05;font-weight:800;box-shadow:0 0 0 4px rgba(184,134,46,.35);text-shadow:0 1px 2px rgba(0,0,0,.35)}
  .bfg-{{ section.id }} .bfg-seal small{font-size:11px;letter-spacing:.04em}
  .bfg-{{ section.id }} .bfg-seal b{font-size:19px}
  .bfg-{{ section.id }} .bfg-name{font-size:24px;font-weight:800;margin:0 0 4px}
  .bfg-{{ section.id }} .bfg-what{font-size:14px;text-transform:uppercase;letter-spacing:.02em;margin:0 0 4px;opacity:.85}
  .bfg-{{ section.id }} .bfg-gifts{list-style:none;padding:0;margin:0 0 14px;font-size:14px;text-transform:uppercase;letter-spacing:.02em;opacity:.85}
  .bfg-{{ section.id }} .bfg-gifts li:before{content:"+ ";font-weight:800;color:{{ s.red }}}
  .bfg-{{ section.id }} .bfg-price{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:auto 0 14px}
  .bfg-{{ section.id }} .bfg-price .now{font-size:26px;font-weight:900;color:#141416}
  .bfg-{{ section.id }} .bfg-price s{opacity:.55;font-size:16px}
  .bfg-{{ section.id }} .bfg-price .sv{background:{{ s.red }};color:#fff;border-radius:999px;font-weight:800;font-size:13px;padding:6px 12px}
  .bfg-{{ section.id }} .bfg-btn{border:0;border-radius:6px;background:#111;color:#fff;font-weight:800;font-size:15px;padding:16px;cursor:pointer;width:100%;text-transform:uppercase;letter-spacing:.04em}
  .bfg-{{ section.id }} .bfg-btn:hover{background:#2a2a2a}
  .bfg-{{ section.id }} .is-hero .bfg-btn{background:#111;color:#fff}
  .bfg-{{ section.id }} .bfg-btn[disabled]{opacity:.6}
  .bfg-{{ section.id }} [hidden]{display:none!important}
  .bfg-{{ section.id }} .bfg-trio{margin:44px auto 0;max-width:900px;display:grid;grid-template-columns:1fr 1.1fr;gap:22px;align-items:center;margin-top:44px}
  .bfg-{{ section.id }} .bfg-trio .bfg-img{margin:0}
  .bfg-{{ section.id }} .bfg-trio-h{font-size:clamp(22px,3vw,30px);font-weight:900;margin:56px 0 6px;color:#1a1a1a!important;-webkit-text-fill-color:#1a1a1a!important;opacity:1!important}
  .bfg-{{ section.id }} .bfg-guar{margin:34px auto 0;max-width:640px;display:flex;gap:12px;align-items:center;justify-content:center;font-size:15px;text-align:left;border:1px dashed rgba(0,0,0,.25);background:#fff;border-radius:12px;padding:14px 18px}
  .bfg-{{ section.id }} .bfg-guar p{margin:0}
  .bfg-{{ section.id }} .bfg-singles-h{margin-top:48px}
  .bfg-{{ section.id }} .bfg-o{display:flex;align-items:center;gap:10px;border:2px solid #eadfd4;border-radius:12px;padding:10px 12px;margin:0 0 8px;cursor:pointer;background:#fff}
  .bfg-{{ section.id }} .bfg-o:has(input:checked){border-color:{{ s.btn }};background:#fff4ec}
  .bfg-{{ section.id }} .bfg-o input{accent-color:{{ s.btn }}}
  .bfg-{{ section.id }} .bfg-o-l{flex:1;font-size:14px;line-height:1.3}
  .bfg-{{ section.id }} .bfg-o-l small{display:block;opacity:.75;font-size:12px}
  .bfg-{{ section.id }} .bfg-o-s{font-style:normal;background:#141416;color:#fff;font-size:11px;font-weight:800;padding:2px 6px;border-radius:5px;margin-left:4px;white-space:nowrap}
  .bfg-{{ section.id }} .bfg-o-p{text-align:right;font-weight:800;font-size:16px;white-space:nowrap}
  .bfg-{{ section.id }} .bfg-o-p s{display:block;font-weight:400;opacity:.5;font-size:12px}
  .bfg-{{ section.id }} .bfg-btn--ghost{display:block;text-align:center;text-decoration:none;background:#fff;color:#141416;border:2px solid #141416}
  
  @media (max-width:820px){
    .bfg-{{ section.id }} .bfg-top{grid-template-columns:1fr;gap:18px;text-align:center;margin-left:-16px;margin-right:-16px}
    .bfg-{{ section.id }} .bfg-top-txt{order:-1;padding:0 18px}
    .bfg-{{ section.id }} .bfg-top img{border-radius:0}
    .bfg-{{ section.id }} .bfg-grid{grid-template-columns:1fr;gap:22px}
    .bfg-{{ section.id }} .bfg-card{max-width:400px;width:100%;margin:0 auto}
    .bfg-{{ section.id }} .bfg-card.is-hero{order:-1;transform:none}
    .bfg-{{ section.id }} .bfg-card.is-hero:hover,.bfg-{{ section.id }} .bfg-card:hover{transform:none}
    .bfg-{{ section.id }} .bfg-grid{gap:34px}
    .bfg-{{ section.id }} .bfg-seal{width:82px;height:82px}
    .bfg-{{ section.id }} .bfg-seal b{font-size:17px}
    .bfg-{{ section.id }} .bfg-trio{grid-template-columns:1fr;max-width:400px}
  }
</style>

<div class="bfg-{{ section.id }}" id="bfg-{{ section.id }}">
  {%- if s.bar_text != blank -%}<div class="bfg-bar">{{ s.bar_text }}</div>{%- endif -%}
  <div class="bfg-wrap">
    <div class="bfg-top">
      {%- if s.hero_d != blank -%}
        <picture>
          {%- if s.hero_m != blank -%}<source media="(max-width:820px)" srcset="{{ s.hero_m | asset_img_url: '900x' }}">{%- endif -%}
          <img src="{{ s.hero_d | asset_img_url: '1400x' }}" alt="{{ s.kicker | escape }}" width="1400" height="782">
        </picture>
      {%- endif -%}
      <div class="bfg-top-txt">
        {%- if s.trust != blank -%}<div class="bfg-trust"><span>★★★★★</span>{{ s.trust }}</div>{%- endif -%}
        {%- if s.badge != blank -%}<div class="bfg-badge">{{ s.badge }}</div>{%- endif -%}
        <div class="bfg-h1">{{ s.heading }}</div>
        {%- if s.sub != blank -%}<p class="bfg-sub">{{ s.sub }}</p>{%- endif -%}
        {%- if s.deadline != blank -%}
          <div class="bfg-cd" data-end="{{ s.deadline }}"><div><b data-d>0</b><small>{{ s.cd_d }}</small></div><div><b data-h>0</b><small>{{ s.cd_h }}</small></div><div><b data-m>0</b><small>{{ s.cd_m }}</small></div><div><b data-s>0</b><small>{{ s.cd_s }}</small></div></div>
        {%- endif -%}
        <button type="button" class="bfg-cta" onclick="var t=document.getElementById('bfg-packs-{{ section.id }}');if(t){window.scrollTo({top:t.getBoundingClientRect().top+window.pageYOffset-90,behavior:'smooth'});}">{{ s.top_cta }} <span>→</span></button>
        {%- if s.usp != blank -%}<div class="bfg-usp">{%- assign ul = s.usp | split: ',' -%}{%- for u in ul -%}<span>{{ u | strip }}</span>{%- endfor -%}</div>{%- endif -%}
      </div>
    </div>

    <p class="bfg-kicker" id="bfg-packs-{{ section.id }}">{{ s.kicker }}</p>
    <h2 class="bfg-h2">{{ s.heading2 }}</h2>

    <div class="bfg-tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button class="bfg-tab" role="tab" type="button" data-tab="{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <div class="bfg-grid" data-panel="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
        {%- for i in (1..3) -%}
          {%- liquid
            if i == 1
              assign p = b.duo
              assign nm = b.duo_name
              assign what = b.duo_text
              assign gifts = b.duo_gifts
              assign qty = 2
              assign hero = false
            elsif i == 2
              assign p = b.month
              assign nm = b.month_name
              assign what = b.month_text
              assign gifts = b.month_gifts
              assign qty = 4
              assign hero = true
            else
              assign p = b.six
              assign nm = b.six_name
              assign what = b.six_text
              assign gifts = b.six_gifts
              assign qty = 6
              assign hero = false
            endif
          -%}
          {%- if p != blank -%}
            {%- liquid
              assign v = p.selected_or_first_available_variant
              assign cmp = v.compare_at_price | default: v.price
              assign saved = cmp | minus: v.price
              assign pct = 0
              if cmp > 0
                assign pct = saved | times: 100 | divided_by: cmp
              endif
              assign unit = v.price | divided_by: qty
            -%}
            <div class="bfg-card{% if hero %} is-hero{% endif %}">
              {%- if hero -%}<div class="bfg-ribbon">{{ s.hero_label }}</div>{%- endif -%}
              <div class="bfg-img">
                {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}
                {%- if pct > 0 -%}<span class="bfg-pct">{{ s.save_label }} {{ pct }} %</span>{%- endif -%}
                <span class="bfg-seal"><small>{{ s.only_label }}</small><b>{{ unit | money }}</b><small>/ {{ s.unit_label }}</small></span>
              </div>
              <div class="bfg-name">{{ nm }}</div>
              <p class="bfg-what">{{ what }}</p>
              {%- if gifts != blank -%}
                <ul class="bfg-gifts">{%- assign gl = gifts | split: ',' -%}{%- for g in gl -%}<li>{{ g | strip }}</li>{%- endfor -%}</ul>
              {%- endif -%}
              <div class="bfg-price"><span class="now">{{ v.price | money }}</span>{%- if saved > 0 -%}<s>{{ cmp | money }}</s><span class="sv">{{ s.save_label }} {{ saved | money }}</span>{%- endif -%}</div>
              <button class="bfg-btn" type="button" data-variant="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
                {%- if v.available -%}{{ s.btn_label }}{%- else -%}{{ s.soldout_label }}{%- endif -%}
              </button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}

    {%- assign t = s.trio -%}
    {%- if t != blank -%}
      {%- liquid
        assign v = t.selected_or_first_available_variant
        assign cmp = v.compare_at_price | default: v.price
        assign saved = cmp | minus: v.price
        assign pct = 0
        if cmp > 0
          assign pct = saved | times: 100 | divided_by: cmp
        endif
      -%}
      <h2 class="bfg-trio-h">{{ s.trio_heading }}</h2>
      <div class="bfg-trio">
        <div class="bfg-img">
          {%- if t.featured_image -%}{{ t.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: t.title }}{%- endif -%}
          {%- if pct > 0 -%}<span class="bfg-pct">{{ s.save_label }} {{ pct }} %</span>{%- endif -%}
        </div>
        <div class="bfg-card">
          <div class="bfg-name">{{ t.title | split: ' (' | first }}</div>
          <p class="bfg-what">{{ s.trio_text }}</p>
          {%- if s.trio_gifts != blank -%}
            <ul class="bfg-gifts">{%- assign gl = s.trio_gifts | split: ',' -%}{%- for g in gl -%}<li>{{ g | strip }}</li>{%- endfor -%}</ul>
          {%- endif -%}
          <div class="bfg-price"><span class="now">{{ v.price | money }}</span>{%- if saved > 0 -%}<s>{{ cmp | money }}</s><span class="sv">{{ s.save_label }} {{ saved | money }}</span>{%- endif -%}</div>
          <button class="bfg-btn" type="button" data-variant="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
            {%- if v.available -%}{{ s.btn_label }}{%- else -%}{{ s.soldout_label }}{%- endif -%}
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- if s.guarantee != blank -%}
      <div class="bfg-guar">
        {%- if s.guarantee_img != blank -%}{{ s.guarantee_img | image_url: width: 140 | image_tag: width: 60, height: 60, loading: 'lazy' }}{%- endif -%}
        <div>{{ s.guarantee }}</div>
      </div>
    {%- endif -%}
    {%- if s.single_1 != blank or s.single_2 != blank or s.single_3 != blank -%}
      <h2 class="bfg-h2 bfg-singles-h">{{ s.singles_heading }}</h2>
      <div class="bfg-grid bfg-singles">
        {%- for n in (1..3) -%}
          {%- liquid
            assign k1 = 'single_' | append: n
            assign k3 = k1 | append: '_3x'
            assign k6 = k1 | append: '_6x'
            assign kt = k1 | append: '_text'
            assign sp = s[k1]
            assign p3 = s[k3]
            assign p6 = s[k6]
            assign stext = s[kt]
          -%}
          {%- if sp != blank -%}
            {%- liquid
              assign v1 = sp.selected_or_first_available_variant
              assign base = v1.price
            -%}
            <div class="bfg-card bfg-opt" data-opt>
              <a class="bfg-img" href="{{ sp.url }}">{%- if sp.featured_image -%}{{ sp.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: sp.title }}{%- endif -%}</a>
              <div class="bfg-name">{{ sp.title }}</div>
              <p class="bfg-what">{{ stext }}</p>
              <label class="bfg-o"><input type="radio" name="o-{{ section.id }}-{{ n }}" value="{{ v1.id }}"><span class="bfg-o-l"><b>1x</b> {{ sp.title }}<small>{{ base | money }} / {{ s.unit_label }}</small></span><span class="bfg-o-p">{{ base | money }}</span></label>
              {%- assign qs = '3,6' | split: ',' -%}
              {%- for qq in qs -%}
                {%- liquid
                  if qq == '3'
                    assign pp = p3
                    assign q = 3
                    assign gifts = s.gift_3
                  else
                    assign pp = p6
                    assign q = 6
                    assign gifts = s.gift_6
                  endif
                -%}
                {%- if pp != blank -%}
                  {%- liquid
                    assign vv = pp.selected_or_first_available_variant
                    assign full = base | times: q
                    assign svd = full | minus: vv.price
                    assign pc = svd | times: 100 | divided_by: full
                    assign per = vv.price | divided_by: q
                  -%}
                  <label class="bfg-o"><input type="radio" name="o-{{ section.id }}-{{ n }}" value="{{ vv.id }}" {% if q == 3 %}checked{% endif %}><span class="bfg-o-l"><b>{{ q }}x</b> {{ sp.title }} <em class="bfg-o-s">{{ s.save_label }} {{ pc }} %</em><small>{{ per | money }} / {{ s.unit_label }} · 🎁 {{ gifts }}</small></span><span class="bfg-o-p">{{ vv.price | money }}<s>{{ full | money }}</s></span></label>
                {%- endif -%}
              {%- endfor -%}
              <button class="bfg-btn" type="button" data-opt-add>{{ s.btn_label }}</button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
(function(){
  var root=document.getElementById('bfg-{{ section.id }}'); if(!root) return;
  root.querySelectorAll('.bfg-tab').forEach(function(t){
    t.addEventListener('click',function(){
      root.querySelectorAll('.bfg-tab').forEach(function(x){x.setAttribute('aria-selected','false')});
      t.setAttribute('aria-selected','true');
      root.querySelectorAll('[data-panel]').forEach(function(p){p.hidden = p.getAttribute('data-panel')!==t.getAttribute('data-tab')});
    });
  });
  var cd=root.querySelector('.bfg-cd');
  if(cd){var end=new Date(cd.getAttribute('data-end')).getTime();var f=function(n){return n<10?'0'+n:n};var tick=function(){var x=Math.max(0,end-Date.now())/1000;cd.querySelector('[data-d]').textContent=Math.floor(x/86400);cd.querySelector('[data-h]').textContent=f(Math.floor(x%86400/3600));cd.querySelector('[data-m]').textContent=f(Math.floor(x%3600/60));cd.querySelector('[data-s]').textContent=f(Math.floor(x%60));};tick();setInterval(tick,1000);}
  var rootUrl=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';
  function addToCart(id,btn){
    btn.disabled=true;
    var cd=document.querySelector('cart-drawer');
    var body={items:[{id:parseInt(id,10),quantity:1}]};
    var canDrawer=cd && typeof cd.renderContents==='function' && typeof cd.getSectionsToRender==='function';
    if(canDrawer){ body.sections=cd.getSectionsToRender().map(function(s){return s.id}); body.sections_url=window.location.pathname; }
    fetch(rootUrl+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body)})
      .then(function(r){return r.json()})
      .then(function(state){
        btn.disabled=false;
        if(state && state.status){ alert(state.description||state.message||'Napaka'); return; }
        if(canDrawer){
          try{
            if(cd.classList.contains('is-empty')) cd.classList.remove('is-empty');
            cd.renderContents(state);
            document.dispatchEvent(new CustomEvent('cart:refresh',{bubbles:true}));
            return;
          }catch(e){}
        }
        window.location.href=rootUrl+'cart';
      })
      .catch(function(){btn.disabled=false; window.location.href=rootUrl+'cart';});
  }
  root.querySelectorAll('[data-opt-add]').forEach(function(b){
    b.addEventListener('click',function(){
      var c=b.closest('[data-opt]').querySelector('input:checked'); if(c) addToCart(c.value,b);
    });
  });
  root.querySelectorAll('.bfg-btn[data-variant]').forEach(function(b){
    b.addEventListener('click',function(){ addToCart(b.getAttribute('data-variant'),b); });
  });
})();
</script>

